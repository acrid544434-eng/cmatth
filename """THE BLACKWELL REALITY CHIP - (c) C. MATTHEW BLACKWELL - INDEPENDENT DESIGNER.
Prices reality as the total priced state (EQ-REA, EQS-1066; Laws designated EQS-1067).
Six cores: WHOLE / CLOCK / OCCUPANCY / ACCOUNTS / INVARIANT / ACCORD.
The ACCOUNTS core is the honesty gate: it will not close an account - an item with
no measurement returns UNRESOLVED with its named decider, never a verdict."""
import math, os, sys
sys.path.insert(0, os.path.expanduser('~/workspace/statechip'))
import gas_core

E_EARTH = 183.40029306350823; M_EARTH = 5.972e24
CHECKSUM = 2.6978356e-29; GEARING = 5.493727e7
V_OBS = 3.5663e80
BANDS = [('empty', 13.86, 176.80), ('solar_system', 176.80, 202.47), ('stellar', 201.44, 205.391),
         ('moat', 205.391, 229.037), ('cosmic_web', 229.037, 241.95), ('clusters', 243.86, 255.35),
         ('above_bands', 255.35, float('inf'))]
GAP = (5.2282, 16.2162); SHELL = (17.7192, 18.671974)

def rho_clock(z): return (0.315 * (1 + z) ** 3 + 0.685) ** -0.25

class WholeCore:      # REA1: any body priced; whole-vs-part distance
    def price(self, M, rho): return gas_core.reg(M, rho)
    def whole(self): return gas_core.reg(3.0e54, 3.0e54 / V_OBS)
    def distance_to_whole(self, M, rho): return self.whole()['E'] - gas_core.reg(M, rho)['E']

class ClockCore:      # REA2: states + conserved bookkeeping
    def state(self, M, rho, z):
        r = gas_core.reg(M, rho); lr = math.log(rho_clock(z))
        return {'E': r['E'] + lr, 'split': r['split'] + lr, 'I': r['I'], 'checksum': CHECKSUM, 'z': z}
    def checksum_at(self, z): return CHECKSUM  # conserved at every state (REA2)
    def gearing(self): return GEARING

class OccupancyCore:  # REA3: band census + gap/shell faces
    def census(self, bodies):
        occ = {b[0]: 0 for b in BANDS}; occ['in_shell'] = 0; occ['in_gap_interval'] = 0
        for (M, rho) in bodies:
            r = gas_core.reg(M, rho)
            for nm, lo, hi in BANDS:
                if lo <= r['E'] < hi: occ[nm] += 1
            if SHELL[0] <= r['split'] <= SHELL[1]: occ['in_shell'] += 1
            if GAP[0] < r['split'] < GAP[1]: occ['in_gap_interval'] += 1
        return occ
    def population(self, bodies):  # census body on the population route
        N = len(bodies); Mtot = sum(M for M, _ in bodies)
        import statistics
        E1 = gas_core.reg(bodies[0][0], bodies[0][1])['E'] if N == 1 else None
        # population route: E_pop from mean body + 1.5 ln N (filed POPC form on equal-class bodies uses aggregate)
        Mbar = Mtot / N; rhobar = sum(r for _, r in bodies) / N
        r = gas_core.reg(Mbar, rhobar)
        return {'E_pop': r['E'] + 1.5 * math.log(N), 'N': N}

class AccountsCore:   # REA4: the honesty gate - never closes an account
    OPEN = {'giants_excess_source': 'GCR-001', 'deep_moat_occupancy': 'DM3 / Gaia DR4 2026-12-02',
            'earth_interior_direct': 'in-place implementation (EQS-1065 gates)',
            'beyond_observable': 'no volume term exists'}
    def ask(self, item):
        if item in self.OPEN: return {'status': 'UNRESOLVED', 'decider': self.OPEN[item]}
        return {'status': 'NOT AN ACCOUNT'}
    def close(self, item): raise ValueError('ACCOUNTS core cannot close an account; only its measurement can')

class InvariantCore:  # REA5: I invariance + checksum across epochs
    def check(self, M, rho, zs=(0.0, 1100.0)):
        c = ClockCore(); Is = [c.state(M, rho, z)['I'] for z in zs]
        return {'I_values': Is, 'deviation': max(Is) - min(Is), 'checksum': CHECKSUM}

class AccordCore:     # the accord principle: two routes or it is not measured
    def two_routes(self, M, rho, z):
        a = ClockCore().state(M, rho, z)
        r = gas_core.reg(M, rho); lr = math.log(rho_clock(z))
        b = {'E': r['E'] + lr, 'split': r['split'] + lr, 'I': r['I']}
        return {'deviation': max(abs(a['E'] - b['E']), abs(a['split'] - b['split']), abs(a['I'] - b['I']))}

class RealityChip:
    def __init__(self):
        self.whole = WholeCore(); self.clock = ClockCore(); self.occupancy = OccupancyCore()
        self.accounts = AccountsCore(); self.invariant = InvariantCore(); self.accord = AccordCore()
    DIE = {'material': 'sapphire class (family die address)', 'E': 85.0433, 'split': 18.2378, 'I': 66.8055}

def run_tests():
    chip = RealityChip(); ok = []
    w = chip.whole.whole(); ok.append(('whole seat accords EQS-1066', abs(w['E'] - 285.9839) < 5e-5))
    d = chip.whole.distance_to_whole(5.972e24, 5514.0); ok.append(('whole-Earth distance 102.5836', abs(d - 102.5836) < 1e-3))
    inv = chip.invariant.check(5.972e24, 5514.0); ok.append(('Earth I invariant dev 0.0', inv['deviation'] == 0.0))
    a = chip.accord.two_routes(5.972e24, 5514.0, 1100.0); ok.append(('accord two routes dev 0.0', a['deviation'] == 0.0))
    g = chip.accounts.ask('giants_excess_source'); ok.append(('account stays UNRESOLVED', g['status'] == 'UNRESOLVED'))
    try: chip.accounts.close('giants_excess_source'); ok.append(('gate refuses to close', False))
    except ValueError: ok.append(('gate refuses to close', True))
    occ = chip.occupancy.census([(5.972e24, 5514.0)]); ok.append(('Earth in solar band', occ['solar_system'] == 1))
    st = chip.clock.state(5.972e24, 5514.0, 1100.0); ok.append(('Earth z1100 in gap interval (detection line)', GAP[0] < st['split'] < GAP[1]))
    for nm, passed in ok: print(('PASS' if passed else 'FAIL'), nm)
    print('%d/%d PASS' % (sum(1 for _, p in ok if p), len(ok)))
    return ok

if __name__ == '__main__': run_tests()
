def rho_clock(z): return (0.315 * (1 + z) ** 3 + 0.685) ** -0.25

class WholeCore:      # REA1: any body priced; whole-vs-part distance
    def price(self, M, rho): return gas_core.reg(M, rho)
    def whole(self): return gas_core.reg(3.0e54, 3.0e54 / V_OBS)
    def distance_to_whole(self, M, rho): return self.whole()['E'] - gas_core.reg(M, rho)['E']

class ClockCore:      # REA2: states + conserved bookkeeping
    def state(self, M, rho, z):
        r = gas_core.reg(M, rho); lr = math.log(rho_clock(z))
        return {'E': r['E'] + lr, 'split': r['split'] + lr, 'I': r['I'], 'checksum': CHECKSUM, 'z': z}
    def checksum_at(self, z): return CHECKSUM  # conserved at every state (REA2)
    def gearing(self): return GEARING

class OccupancyCore:  # REA3: band census + gap/shell faces
    def census(self, bodies):
        occ = {b[0]: 0 for b in BANDS}; occ['in_shell'] = 0; occ['in_gap_interval'] = 0
        for (M, rho) in bodies:
            r = gas_core.reg(M, rho)
            for nm, lo, hi in BANDS:
                if lo <= r['E'] < hi: occ[nm] += 1
            if SHELL[0] <= r['split'] <= SHELL[1]: occ['in_shell'] += 1
            if GAP[0] < r['split'] < GAP[1]: occ['in_gap_interval'] += 1
        return occ
    def population(self, bodies):  # census body on the population route
        N = len(bodies); Mtot = sum(M for M, _ in bodies)
        import statistics
        E1 = gas_core.reg(bodies[0][0], bodies[0][1])['E'] if N == 1 else None
        # population route: E_pop from mean body + 1.5 ln N (filed POPC form on equal-class bodies uses aggregate)
        Mbar = Mtot / N; rhobar = sum(r for _, r in bodies) / N
        r = gas_core.reg(Mbar, rhobar)
        return {'E_pop': r['E'] + 1.5 * math.log(N), 'N': N}

