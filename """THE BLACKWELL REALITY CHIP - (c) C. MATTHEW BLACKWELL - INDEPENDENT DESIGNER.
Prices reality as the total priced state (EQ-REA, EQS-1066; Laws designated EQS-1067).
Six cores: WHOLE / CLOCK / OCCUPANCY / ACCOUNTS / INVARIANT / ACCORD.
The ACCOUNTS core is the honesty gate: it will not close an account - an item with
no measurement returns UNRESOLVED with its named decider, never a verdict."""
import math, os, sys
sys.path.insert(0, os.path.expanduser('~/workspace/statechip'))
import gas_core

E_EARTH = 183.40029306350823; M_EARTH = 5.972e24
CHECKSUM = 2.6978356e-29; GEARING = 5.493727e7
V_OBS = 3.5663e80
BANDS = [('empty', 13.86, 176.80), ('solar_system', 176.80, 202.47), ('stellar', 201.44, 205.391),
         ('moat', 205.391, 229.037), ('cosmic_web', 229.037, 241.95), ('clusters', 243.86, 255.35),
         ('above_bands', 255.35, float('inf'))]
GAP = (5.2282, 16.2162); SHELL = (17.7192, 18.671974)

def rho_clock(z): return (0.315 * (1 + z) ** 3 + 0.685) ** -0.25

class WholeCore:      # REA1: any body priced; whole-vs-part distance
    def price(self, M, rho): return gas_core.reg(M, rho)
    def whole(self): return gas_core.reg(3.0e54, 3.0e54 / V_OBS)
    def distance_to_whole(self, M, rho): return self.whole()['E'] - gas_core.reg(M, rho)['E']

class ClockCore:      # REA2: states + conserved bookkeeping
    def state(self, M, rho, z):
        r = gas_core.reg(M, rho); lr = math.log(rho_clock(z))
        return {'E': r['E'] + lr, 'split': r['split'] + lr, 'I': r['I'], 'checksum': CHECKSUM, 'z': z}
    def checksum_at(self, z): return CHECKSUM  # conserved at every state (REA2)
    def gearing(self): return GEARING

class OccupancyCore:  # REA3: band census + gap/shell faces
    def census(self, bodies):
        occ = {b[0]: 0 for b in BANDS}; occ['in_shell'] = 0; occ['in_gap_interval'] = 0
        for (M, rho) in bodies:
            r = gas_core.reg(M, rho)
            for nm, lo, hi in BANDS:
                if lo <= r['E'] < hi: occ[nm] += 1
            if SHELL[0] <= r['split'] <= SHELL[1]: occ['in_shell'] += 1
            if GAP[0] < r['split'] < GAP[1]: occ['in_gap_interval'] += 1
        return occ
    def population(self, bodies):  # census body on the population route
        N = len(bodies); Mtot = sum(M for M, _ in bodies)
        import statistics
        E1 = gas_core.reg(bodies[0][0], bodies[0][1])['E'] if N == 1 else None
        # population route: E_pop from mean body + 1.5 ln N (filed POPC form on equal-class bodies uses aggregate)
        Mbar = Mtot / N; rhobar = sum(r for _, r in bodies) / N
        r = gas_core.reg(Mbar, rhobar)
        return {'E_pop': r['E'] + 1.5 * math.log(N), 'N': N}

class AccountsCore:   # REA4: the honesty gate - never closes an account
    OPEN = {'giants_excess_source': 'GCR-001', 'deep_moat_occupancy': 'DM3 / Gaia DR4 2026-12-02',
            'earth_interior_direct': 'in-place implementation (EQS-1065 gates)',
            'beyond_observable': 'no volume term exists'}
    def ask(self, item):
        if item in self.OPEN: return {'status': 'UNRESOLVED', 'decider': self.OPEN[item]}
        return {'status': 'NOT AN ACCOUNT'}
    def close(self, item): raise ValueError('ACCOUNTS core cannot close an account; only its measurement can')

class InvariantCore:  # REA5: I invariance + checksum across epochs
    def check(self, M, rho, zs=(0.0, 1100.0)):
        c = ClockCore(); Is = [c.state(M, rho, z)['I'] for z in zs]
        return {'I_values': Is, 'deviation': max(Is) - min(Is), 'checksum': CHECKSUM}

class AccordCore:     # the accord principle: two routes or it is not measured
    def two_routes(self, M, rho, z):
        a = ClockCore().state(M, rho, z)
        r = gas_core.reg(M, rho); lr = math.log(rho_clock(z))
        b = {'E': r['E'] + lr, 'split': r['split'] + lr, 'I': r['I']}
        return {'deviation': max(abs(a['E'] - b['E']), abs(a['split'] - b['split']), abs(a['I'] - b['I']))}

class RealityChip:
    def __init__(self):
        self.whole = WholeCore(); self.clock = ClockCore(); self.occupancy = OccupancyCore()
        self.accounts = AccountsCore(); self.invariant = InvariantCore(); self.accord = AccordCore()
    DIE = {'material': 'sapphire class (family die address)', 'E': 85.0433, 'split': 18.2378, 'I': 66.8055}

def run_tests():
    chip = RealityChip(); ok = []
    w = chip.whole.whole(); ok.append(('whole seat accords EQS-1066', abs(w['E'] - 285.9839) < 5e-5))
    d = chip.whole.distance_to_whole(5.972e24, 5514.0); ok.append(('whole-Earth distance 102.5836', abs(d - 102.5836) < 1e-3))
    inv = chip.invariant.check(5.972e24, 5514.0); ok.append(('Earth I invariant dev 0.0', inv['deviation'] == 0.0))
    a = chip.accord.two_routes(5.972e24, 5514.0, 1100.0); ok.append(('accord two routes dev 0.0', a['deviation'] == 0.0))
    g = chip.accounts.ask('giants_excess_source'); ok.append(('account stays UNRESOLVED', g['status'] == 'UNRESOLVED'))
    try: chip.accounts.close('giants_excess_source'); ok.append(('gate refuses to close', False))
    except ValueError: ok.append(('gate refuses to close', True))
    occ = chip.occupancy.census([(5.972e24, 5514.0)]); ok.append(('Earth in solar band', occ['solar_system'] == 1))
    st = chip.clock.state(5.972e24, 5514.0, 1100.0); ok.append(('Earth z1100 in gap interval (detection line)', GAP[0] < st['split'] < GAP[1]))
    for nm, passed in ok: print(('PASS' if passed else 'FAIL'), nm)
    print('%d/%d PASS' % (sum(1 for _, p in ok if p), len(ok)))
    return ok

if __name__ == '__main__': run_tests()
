class InvariantCore:  # REA5: I invariance + checksum across epochs
    def check(self, M, rho, zs=(0.0, 1100.0)):
        c = ClockCore(); Is = [c.state(M, rho, z)['I'] for z in zs]
        return {'I_values': Is, 'deviation': max(Is) - min(Is), 'checksum': CHECKSUM}

class AccordCore:     # the accord principle: two routes or it is not measured
    def two_routes(self, M, rho, z):
        a = ClockCore().state(M, rho, z)
        r = gas_core.reg(M, rho); lr = math.log(rho_clock(z))
        b = {'E': r['E'] + lr, 'split': r['split'] + lr, 'I': r['I']}
        return {'deviation': max(abs(a['E'] - b['E']), abs(a['split'] - b['split']), abs(a['I'] - b['I']))}

