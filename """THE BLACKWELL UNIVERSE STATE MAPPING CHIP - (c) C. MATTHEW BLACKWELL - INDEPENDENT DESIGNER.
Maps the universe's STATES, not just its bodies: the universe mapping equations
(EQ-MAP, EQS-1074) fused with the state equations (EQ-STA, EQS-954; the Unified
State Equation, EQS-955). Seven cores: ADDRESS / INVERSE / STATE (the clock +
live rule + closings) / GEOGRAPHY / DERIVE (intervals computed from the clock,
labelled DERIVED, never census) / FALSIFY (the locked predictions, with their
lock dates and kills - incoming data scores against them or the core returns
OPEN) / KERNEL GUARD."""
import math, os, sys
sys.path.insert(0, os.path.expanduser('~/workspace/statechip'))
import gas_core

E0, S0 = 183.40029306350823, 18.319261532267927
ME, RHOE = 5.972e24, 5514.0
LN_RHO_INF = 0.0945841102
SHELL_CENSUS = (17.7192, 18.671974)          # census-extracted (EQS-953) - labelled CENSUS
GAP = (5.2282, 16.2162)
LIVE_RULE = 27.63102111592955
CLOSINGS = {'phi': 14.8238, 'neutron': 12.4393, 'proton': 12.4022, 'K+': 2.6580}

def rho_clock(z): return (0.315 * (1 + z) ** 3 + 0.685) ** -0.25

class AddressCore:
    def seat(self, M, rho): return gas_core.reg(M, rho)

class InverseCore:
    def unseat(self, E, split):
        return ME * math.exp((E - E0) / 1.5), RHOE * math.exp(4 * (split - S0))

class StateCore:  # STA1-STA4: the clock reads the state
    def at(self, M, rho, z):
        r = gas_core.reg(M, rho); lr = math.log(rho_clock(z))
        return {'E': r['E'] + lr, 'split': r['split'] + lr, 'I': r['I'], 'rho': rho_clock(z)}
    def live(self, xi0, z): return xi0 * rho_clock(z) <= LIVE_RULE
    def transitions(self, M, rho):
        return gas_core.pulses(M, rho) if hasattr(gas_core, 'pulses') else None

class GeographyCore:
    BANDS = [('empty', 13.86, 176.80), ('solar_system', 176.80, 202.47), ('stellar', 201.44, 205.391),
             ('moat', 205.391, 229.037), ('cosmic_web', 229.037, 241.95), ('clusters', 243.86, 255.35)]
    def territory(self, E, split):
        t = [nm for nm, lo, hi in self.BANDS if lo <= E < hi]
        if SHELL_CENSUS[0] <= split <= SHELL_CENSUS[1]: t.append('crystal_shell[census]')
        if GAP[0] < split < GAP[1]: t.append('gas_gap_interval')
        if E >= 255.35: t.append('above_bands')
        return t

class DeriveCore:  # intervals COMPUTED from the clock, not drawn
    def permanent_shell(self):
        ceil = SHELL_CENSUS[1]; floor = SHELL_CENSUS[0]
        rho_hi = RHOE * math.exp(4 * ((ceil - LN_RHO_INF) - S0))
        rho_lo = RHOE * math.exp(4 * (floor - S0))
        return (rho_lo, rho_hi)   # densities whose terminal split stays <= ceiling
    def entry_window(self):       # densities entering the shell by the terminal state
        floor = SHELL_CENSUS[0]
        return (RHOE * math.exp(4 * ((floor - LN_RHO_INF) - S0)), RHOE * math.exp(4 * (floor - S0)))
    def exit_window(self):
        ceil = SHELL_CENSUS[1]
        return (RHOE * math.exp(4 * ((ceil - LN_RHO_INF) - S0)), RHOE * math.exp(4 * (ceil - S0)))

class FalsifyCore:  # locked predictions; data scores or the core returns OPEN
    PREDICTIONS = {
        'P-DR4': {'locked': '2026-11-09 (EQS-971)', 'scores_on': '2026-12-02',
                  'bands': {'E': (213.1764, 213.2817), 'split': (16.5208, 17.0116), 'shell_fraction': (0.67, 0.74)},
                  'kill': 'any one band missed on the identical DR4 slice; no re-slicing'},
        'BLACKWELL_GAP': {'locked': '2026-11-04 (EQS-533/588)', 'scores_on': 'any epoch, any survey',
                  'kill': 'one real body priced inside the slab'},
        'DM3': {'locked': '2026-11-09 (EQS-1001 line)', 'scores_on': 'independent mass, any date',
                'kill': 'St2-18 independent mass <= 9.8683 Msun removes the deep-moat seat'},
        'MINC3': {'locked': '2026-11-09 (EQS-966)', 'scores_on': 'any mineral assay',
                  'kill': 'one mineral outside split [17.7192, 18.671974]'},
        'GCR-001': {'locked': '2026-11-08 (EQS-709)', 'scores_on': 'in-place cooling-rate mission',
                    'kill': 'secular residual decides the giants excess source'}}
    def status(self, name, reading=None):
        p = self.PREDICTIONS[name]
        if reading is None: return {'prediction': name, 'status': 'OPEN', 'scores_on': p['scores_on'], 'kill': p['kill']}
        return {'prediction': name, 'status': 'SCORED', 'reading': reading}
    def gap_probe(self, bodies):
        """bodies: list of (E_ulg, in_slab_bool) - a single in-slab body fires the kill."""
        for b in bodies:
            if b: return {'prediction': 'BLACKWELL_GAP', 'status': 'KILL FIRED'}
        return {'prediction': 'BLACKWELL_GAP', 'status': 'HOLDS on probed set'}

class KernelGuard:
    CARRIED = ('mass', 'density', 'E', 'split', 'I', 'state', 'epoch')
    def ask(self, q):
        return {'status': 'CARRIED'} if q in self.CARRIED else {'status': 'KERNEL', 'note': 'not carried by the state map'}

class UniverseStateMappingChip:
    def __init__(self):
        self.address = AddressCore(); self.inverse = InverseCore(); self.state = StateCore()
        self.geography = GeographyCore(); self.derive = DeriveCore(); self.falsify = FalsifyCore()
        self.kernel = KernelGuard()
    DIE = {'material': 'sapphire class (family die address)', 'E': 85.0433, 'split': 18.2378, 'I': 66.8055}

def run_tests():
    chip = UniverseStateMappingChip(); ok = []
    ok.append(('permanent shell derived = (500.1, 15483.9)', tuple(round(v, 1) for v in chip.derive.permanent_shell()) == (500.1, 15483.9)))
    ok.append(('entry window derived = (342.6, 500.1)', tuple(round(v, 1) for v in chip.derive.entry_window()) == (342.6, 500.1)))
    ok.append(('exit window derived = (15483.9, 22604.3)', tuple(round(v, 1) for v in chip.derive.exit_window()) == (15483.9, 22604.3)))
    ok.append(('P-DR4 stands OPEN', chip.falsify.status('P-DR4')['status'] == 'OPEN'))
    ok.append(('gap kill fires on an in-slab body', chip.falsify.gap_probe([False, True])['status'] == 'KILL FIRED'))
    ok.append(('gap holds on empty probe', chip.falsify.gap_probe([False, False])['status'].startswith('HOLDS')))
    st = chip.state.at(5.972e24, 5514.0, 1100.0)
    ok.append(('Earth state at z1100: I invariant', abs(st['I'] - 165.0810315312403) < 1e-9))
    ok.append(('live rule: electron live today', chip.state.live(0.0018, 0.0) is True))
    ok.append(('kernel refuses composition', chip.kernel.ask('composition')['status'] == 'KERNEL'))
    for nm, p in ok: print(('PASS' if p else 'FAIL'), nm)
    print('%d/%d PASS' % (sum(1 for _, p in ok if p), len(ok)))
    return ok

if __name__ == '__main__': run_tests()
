def rho_clock(z): return (0.315 * (1 + z) ** 3 + 0.685) ** -0.25

class AddressCore:
    def seat(self, M, rho): return gas_core.reg(M, rho)

class InverseCore:
    def unseat(self, E, split):
        return ME * math.exp((E - E0) / 1.5), RHOE * math.exp(4 * (split - S0))

class StateCore:  # STA1-STA4: the clock reads the state
    def at(self, M, rho, z):
        r = gas_core.reg(M, rho); lr = math.log(rho_clock(z))
        return {'E': r['E'] + lr, 'split': r['split'] + lr, 'I': r['I'], 'rho': rho_clock(z)}
    def live(self, xi0, z): return xi0 * rho_clock(z) <= LIVE_RULE
    def transitions(self, M, rho):
        return gas_core.pulses(M, rho) if hasattr(gas_core, 'pulses') else None

class GeographyCore:
    BANDS = [('empty', 13.86, 176.80), ('solar_system', 176.80, 202.47), ('stellar', 201.44, 205.391),
             ('moat', 205.391, 229.037), ('cosmic_web', 229.037, 241.95), ('clusters', 243.86, 255.35)]
    def territory(self, E, split):
        t = [nm for nm, lo, hi in self.BANDS if lo <= E < hi]
        if SHELL_CENSUS[0] <= split <= SHELL_CENSUS[1]: t.append('crystal_shell[census]')
        if GAP[0] < split < GAP[1]: t.append('gas_gap_interval')
        if E >= 255.35: t.append('above_bands')
        return t

class DeriveCore:  # intervals COMPUTED from the clock, not drawn
    def permanent_shell(self):
        ceil = SHELL_CENSUS[1]; floor = SHELL_CENSUS[0]
        rho_hi = RHOE * math.exp(4 * ((ceil - LN_RHO_INF) - S0))
        rho_lo = RHOE * math.exp(4 * (floor - S0))
        return (rho_lo, rho_hi)   # densities whose terminal split stays <= ceiling
    def entry_window(self):       # densities entering the shell by the terminal state
        floor = SHELL_CENSUS[0]
        return (RHOE * math.exp(4 * ((floor - LN_RHO_INF) - S0)), RHOE * math.exp(4 * (floor - S0)))
    def exit_window(self):
        ceil = SHELL_CENSUS[1]
        return (RHOE * math.exp(4 * ((ceil - LN_RHO_INF) - S0)), RHOE * math.exp(4 * (ceil - S0)))

