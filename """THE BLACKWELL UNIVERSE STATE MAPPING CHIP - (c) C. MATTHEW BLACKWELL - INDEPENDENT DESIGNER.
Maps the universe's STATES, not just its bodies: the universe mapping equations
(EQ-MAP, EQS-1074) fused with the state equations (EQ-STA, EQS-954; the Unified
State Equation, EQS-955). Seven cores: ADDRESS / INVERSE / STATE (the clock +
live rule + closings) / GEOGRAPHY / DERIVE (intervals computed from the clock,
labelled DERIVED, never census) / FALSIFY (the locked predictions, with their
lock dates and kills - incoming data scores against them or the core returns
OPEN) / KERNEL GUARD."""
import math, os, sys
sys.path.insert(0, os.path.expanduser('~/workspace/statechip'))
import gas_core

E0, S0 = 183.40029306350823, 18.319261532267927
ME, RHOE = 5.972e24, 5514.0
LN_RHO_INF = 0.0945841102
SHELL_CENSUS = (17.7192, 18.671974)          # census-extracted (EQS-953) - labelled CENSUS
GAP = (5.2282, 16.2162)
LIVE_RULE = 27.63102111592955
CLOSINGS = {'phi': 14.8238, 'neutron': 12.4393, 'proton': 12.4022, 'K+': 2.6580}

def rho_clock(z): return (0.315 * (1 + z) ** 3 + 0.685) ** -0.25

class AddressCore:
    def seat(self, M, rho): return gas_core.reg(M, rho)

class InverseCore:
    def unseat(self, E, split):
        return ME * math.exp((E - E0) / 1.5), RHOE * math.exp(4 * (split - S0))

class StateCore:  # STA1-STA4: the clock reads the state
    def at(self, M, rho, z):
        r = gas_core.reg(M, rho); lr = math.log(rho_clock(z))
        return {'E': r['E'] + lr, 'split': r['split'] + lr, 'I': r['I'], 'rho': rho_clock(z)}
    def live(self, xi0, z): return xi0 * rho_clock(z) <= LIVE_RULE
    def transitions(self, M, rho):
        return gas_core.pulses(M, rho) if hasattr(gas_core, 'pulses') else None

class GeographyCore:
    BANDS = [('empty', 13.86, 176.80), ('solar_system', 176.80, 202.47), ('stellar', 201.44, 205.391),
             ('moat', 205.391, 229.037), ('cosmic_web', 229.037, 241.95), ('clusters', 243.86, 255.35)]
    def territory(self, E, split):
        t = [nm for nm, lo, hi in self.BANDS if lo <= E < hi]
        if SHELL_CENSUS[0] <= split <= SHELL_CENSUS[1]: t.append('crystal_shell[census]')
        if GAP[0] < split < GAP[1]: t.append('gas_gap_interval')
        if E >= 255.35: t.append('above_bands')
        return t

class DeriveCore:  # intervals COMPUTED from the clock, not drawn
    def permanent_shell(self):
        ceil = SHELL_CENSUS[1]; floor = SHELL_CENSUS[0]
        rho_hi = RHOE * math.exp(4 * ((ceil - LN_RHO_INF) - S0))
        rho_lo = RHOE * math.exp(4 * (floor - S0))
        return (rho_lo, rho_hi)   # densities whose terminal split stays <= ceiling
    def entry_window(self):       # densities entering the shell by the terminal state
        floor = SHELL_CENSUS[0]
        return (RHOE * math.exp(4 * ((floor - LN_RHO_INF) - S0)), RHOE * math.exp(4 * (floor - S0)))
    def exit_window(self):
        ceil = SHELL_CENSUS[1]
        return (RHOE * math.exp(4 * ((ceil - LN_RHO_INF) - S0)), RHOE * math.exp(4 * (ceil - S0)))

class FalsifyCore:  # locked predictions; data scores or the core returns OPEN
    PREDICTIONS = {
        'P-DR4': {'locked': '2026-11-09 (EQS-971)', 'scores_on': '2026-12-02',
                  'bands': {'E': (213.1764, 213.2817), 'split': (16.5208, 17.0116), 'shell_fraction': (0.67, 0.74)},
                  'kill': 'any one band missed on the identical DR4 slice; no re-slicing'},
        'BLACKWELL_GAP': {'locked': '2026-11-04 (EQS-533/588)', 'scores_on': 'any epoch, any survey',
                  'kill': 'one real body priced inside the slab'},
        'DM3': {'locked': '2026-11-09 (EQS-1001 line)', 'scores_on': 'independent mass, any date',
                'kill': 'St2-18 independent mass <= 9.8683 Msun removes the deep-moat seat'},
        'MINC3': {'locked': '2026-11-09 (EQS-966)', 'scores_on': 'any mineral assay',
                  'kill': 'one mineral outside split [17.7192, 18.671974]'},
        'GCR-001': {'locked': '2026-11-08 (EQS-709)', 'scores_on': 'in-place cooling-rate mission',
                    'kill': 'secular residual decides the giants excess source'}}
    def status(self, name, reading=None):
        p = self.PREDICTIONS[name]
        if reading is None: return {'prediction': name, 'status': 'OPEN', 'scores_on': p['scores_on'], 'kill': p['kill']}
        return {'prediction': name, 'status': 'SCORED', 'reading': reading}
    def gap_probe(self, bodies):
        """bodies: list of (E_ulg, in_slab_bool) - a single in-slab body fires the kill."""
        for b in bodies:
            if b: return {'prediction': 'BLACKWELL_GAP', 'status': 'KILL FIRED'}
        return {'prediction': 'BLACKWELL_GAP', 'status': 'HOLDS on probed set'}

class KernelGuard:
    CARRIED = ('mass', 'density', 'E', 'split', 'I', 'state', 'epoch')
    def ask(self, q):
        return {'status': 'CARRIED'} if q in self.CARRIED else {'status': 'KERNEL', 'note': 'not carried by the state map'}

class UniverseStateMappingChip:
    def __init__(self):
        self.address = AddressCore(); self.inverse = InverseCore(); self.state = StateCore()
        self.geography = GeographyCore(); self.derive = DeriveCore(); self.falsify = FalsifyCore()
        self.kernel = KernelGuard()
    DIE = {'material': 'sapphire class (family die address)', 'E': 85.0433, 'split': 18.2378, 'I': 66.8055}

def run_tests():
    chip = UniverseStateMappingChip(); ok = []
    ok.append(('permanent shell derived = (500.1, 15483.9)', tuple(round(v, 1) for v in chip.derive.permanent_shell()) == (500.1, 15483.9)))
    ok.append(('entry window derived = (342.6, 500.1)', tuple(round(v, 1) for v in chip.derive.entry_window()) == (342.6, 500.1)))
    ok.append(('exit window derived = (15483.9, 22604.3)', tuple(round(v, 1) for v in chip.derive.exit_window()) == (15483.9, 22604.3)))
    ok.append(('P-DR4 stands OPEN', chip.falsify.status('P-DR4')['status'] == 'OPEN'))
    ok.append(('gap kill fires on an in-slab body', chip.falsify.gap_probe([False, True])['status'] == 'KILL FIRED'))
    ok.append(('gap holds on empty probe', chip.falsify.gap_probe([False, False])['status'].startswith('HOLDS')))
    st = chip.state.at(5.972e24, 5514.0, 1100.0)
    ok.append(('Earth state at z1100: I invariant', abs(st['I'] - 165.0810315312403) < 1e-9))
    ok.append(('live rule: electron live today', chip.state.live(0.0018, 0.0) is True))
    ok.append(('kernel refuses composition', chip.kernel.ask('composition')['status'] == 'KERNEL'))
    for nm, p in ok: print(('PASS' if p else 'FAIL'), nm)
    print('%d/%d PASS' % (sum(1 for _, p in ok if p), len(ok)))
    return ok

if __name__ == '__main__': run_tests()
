class KernelGuard:
    CARRIED = ('mass', 'density', 'E', 'split', 'I', 'state', 'epoch')
    def ask(self, q):
        return {'status': 'CARRIED'} if q in self.CARRIED else {'status': 'KERNEL', 'note': 'not carried by the state map'}

