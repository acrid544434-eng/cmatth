import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

def run_coupled_catastrophe_simulation():
    print("--- [APEX_Core] Initializing Coupled Stratovolcano-Tsunami Simulation ---")
    
    # Parameters for the metriplectic system
    omega = 1.5
    m = 1.0
    gamma = 0.1  # Dissipation damping factor
    
    # State vector: [q1, q2, q3, p1, p2, p3]
    def system_dynamics(t, y):
        q1, q2, q3, p1, p2, p3 = y
        
        # Hamiltonian equations with metriplectic damping on momenta
        dq1_dt = p1 / m
        dq2_dt = p2 / m
        dq3_dt = p3 / m
        
        dp1_dt = -m * (omega**2) * q1 - gamma * p1
        dp2_dt = -m * (omega**2) * q2 - gamma * p2
        dp3_dt = -m * (omega**2) * q3 - gamma * p3
        
        return [dq1_dt, dq2_dt, dq3_dt, dp1_dt, dp2_dt, dp3_dt]

    # Initial conditions representing an elevated energy state (catastrophe trigger)
    initial_state = [0.8, 0.6, 0.5, 1.2, -0.8, 0.4]
    t_span = (0, 20)
    t_eval = np.linspace(0, 20, 1000)
    
    # Solve ODE system
    sol = solve_ivp(system_dynamics, t_span, initial_state, t_eval=t_eval, method='RK45')
    
    print(f"Simulation completed across {len(sol.t)} temporal evaluation points.")
    return sol

if __name__ == "__main__":
    simulation_results = run_coupled_catastrophe_simulation()

