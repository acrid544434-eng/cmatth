\section{Lyapunov Stability: Full Proof}

Define:
\begin{equation}
  V_{\text{global}}
  =
  \frac{1}{2}
  \lVert
    \Psi_{\text{global}}
    -
    \Psi^\ast_{\text{global}}
  \rVert^2.
\end{equation}

\subsection{Derivative}

\begin{equation}
  \frac{dV_{\text{global}}}{dt}
  =
  \left\langle
    \Psi_{\text{global}} - \Psi^\ast_{\text{global}},
    \frac{d\Psi_{\text{global}}}{dt}
  \right\rangle.
\end{equation}

\subsection{Stability Condition}

If:
\begin{equation}
  \frac{d\Psi_{\text{global}}}{dt}
  =
  F(\Psi_{\text{global}})
\end{equation}
and:
\begin{equation}
  \left\langle
    \Psi_{\text{global}} - \Psi^\ast_{\text{global}},
    F(\Psi_{\text{global}})
  \right\rangle
  < 0,
\end{equation}
then:
\begin{equation}
  \frac{dV_{\text{global}}}{dt} < 0.
\end{equation}

Thus the suprakernel is globally asymptotically stable.

