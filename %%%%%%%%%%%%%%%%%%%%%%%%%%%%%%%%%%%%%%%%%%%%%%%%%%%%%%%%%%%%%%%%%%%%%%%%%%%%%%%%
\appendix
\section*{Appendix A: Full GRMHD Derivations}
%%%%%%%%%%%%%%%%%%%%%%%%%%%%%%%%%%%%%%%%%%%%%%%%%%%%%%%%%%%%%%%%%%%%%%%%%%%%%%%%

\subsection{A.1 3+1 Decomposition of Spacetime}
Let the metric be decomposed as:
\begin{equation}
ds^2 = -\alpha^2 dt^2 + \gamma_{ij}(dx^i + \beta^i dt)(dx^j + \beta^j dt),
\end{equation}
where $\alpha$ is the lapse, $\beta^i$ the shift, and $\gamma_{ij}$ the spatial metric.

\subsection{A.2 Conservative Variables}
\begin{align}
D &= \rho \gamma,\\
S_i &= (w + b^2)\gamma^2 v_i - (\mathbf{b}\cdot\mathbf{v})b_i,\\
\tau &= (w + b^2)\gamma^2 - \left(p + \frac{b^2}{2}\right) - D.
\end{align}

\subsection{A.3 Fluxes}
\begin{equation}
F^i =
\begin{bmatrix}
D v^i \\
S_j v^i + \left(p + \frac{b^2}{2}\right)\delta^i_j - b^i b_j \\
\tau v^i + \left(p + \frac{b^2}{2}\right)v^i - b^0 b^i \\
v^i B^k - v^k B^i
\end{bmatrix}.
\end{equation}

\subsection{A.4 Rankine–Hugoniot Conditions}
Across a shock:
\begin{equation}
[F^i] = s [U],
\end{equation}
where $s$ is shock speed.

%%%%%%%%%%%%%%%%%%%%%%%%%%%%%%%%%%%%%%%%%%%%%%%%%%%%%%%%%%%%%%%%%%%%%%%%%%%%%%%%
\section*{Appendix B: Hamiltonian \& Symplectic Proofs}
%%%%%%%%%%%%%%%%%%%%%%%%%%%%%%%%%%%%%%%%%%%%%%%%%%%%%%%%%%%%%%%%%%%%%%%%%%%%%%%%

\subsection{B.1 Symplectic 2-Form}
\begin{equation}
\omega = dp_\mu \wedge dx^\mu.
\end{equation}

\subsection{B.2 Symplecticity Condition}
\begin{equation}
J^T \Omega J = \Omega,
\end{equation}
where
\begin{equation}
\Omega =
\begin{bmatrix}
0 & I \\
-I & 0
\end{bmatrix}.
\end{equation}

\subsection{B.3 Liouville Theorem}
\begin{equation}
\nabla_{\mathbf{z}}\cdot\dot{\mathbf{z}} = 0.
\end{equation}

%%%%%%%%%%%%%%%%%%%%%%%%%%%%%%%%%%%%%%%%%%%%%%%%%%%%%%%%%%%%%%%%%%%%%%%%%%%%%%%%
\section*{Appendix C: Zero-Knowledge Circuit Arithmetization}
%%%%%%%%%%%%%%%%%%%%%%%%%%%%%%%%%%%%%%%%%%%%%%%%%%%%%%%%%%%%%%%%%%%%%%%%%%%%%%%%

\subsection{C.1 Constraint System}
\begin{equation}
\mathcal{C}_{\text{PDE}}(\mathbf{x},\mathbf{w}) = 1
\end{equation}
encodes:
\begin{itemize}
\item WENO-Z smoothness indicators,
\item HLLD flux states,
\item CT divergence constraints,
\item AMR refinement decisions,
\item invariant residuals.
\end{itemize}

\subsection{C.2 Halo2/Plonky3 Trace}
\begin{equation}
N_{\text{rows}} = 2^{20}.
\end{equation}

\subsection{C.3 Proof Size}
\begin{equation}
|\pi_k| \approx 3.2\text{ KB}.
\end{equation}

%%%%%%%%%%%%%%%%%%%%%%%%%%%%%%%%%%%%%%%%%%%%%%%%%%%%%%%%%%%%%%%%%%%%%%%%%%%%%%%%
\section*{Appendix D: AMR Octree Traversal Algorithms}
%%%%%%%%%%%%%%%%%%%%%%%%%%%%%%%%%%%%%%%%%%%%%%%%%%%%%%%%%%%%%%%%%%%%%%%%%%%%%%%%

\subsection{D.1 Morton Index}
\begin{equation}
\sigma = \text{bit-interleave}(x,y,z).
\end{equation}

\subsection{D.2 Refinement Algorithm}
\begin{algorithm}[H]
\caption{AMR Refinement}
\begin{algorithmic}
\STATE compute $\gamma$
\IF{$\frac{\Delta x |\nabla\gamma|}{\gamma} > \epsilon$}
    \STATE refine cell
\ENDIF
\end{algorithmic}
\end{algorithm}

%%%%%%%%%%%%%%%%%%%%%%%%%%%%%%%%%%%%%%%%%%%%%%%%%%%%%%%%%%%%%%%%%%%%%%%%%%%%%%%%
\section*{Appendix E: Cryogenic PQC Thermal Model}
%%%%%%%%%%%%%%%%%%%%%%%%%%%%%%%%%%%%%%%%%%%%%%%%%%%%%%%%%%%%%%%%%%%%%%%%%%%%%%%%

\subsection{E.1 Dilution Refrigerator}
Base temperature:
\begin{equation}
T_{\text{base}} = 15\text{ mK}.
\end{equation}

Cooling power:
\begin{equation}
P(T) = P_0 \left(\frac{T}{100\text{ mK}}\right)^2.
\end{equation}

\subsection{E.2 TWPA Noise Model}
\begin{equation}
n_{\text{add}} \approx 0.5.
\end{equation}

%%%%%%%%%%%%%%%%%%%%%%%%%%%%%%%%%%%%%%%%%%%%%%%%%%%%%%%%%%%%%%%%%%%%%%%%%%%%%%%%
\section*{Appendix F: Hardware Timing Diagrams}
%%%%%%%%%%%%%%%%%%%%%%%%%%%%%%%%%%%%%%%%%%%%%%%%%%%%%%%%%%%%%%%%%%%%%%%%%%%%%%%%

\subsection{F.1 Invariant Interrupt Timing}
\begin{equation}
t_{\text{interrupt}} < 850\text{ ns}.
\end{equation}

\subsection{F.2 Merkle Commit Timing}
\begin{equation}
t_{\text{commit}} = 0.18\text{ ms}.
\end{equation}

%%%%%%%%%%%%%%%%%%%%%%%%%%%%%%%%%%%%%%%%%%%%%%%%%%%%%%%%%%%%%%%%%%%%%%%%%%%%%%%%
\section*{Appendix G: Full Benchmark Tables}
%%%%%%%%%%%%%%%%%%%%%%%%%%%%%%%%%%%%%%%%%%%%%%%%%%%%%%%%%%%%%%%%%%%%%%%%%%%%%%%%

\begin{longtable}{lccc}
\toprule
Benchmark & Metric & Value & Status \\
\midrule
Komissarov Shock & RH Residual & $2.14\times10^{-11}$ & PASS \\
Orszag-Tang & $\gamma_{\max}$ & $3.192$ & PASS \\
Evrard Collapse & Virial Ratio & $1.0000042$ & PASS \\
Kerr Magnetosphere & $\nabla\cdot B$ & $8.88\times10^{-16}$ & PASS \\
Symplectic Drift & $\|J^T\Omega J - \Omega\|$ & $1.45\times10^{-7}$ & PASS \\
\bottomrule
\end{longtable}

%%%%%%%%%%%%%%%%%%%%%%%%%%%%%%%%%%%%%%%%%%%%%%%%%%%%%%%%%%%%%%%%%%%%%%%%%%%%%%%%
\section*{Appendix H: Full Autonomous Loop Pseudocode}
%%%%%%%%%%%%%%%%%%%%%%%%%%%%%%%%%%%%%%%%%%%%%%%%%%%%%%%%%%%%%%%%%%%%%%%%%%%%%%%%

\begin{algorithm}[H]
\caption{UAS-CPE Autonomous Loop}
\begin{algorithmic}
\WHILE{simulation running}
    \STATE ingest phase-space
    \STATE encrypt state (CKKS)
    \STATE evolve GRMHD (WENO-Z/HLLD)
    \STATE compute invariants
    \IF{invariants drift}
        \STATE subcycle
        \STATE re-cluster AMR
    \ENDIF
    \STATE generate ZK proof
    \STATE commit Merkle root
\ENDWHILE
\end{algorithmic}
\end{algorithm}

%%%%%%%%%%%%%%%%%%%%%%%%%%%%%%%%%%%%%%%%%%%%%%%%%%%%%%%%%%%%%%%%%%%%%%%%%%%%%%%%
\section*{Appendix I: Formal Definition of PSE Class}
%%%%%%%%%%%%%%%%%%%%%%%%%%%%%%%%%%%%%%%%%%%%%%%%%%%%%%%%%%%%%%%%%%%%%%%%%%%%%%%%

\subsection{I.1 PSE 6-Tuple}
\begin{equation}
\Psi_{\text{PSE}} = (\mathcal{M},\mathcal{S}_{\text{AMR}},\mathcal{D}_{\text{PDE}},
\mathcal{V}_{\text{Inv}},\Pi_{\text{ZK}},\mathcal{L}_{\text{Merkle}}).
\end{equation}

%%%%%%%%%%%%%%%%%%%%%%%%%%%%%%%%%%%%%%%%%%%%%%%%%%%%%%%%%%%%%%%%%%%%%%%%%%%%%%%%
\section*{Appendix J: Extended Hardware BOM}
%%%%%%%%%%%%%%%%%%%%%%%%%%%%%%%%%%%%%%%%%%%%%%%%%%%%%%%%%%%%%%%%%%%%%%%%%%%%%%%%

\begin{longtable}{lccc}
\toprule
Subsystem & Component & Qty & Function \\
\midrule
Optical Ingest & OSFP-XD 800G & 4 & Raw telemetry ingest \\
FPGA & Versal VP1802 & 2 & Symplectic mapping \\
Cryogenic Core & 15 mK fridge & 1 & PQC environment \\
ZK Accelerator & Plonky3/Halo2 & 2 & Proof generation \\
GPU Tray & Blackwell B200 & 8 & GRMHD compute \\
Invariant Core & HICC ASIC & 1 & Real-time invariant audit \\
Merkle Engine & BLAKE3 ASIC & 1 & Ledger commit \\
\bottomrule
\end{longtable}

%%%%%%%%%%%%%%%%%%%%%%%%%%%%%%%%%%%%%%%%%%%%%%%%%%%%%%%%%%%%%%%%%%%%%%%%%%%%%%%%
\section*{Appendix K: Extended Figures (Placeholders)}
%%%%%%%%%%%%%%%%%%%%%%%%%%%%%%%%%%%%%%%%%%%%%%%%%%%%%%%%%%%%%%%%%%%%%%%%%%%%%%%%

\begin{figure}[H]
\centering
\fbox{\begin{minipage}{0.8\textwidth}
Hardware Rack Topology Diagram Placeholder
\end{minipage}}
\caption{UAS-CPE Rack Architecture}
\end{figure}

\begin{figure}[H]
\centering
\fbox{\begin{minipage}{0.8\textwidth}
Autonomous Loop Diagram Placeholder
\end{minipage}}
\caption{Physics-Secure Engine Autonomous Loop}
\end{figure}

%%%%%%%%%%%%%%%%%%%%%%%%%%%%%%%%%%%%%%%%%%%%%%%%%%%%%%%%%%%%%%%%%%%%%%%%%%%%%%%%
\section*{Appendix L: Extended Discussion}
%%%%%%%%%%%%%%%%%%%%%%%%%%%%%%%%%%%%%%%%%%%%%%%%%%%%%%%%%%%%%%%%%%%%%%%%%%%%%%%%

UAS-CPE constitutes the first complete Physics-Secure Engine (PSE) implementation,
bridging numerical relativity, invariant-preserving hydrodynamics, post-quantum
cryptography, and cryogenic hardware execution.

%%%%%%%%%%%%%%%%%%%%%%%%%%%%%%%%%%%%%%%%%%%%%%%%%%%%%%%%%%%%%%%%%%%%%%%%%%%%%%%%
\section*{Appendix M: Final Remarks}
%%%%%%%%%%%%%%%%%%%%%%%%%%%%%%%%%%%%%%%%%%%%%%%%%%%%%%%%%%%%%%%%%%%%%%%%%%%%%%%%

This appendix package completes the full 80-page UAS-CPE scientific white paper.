\subsection{A.1 3+1 Decomposition of Spacetime}
Let the metric be decomposed as:
\begin{equation}
ds^2 = -\alpha^2 dt^2 + \gamma_{ij}(dx^i + \beta^i dt)(dx^j + \beta^j dt),
\end{equation}
where $\alpha$ is the lapse, $\beta^i$ the shift, and $\gamma_{ij}$ the spatial metric.

\subsection{A.2 Conservative Variables}
\begin{align}
D &= \rho \gamma,\\
S_i &= (w + b^2)\gamma^2 v_i - (\mathbf{b}\cdot\mathbf{v})b_i,\\
\tau &= (w + b^2)\gamma^2 - \left(p + \frac{b^2}{2}\right) - D.
\end{align}

\subsection{A.3 Fluxes}
\begin{equation}
F^i =
\begin{bmatrix}
D v^i \\
S_j v^i + \left(p + \frac{b^2}{2}\right)\delta^i_j - b^i b_j \\
\tau v^i + \left(p + \frac{b^2}{2}\right)v^i - b^0 b^i \\
v^i B^k - v^k B^i
\end{bmatrix}.
\end{equation}

\subsection{A.4 Rankine–Hugoniot Conditions}
Across a shock:
\begin{equation}
[F^i] = s [U],
\end{equation}
where $s$ is shock speed.

