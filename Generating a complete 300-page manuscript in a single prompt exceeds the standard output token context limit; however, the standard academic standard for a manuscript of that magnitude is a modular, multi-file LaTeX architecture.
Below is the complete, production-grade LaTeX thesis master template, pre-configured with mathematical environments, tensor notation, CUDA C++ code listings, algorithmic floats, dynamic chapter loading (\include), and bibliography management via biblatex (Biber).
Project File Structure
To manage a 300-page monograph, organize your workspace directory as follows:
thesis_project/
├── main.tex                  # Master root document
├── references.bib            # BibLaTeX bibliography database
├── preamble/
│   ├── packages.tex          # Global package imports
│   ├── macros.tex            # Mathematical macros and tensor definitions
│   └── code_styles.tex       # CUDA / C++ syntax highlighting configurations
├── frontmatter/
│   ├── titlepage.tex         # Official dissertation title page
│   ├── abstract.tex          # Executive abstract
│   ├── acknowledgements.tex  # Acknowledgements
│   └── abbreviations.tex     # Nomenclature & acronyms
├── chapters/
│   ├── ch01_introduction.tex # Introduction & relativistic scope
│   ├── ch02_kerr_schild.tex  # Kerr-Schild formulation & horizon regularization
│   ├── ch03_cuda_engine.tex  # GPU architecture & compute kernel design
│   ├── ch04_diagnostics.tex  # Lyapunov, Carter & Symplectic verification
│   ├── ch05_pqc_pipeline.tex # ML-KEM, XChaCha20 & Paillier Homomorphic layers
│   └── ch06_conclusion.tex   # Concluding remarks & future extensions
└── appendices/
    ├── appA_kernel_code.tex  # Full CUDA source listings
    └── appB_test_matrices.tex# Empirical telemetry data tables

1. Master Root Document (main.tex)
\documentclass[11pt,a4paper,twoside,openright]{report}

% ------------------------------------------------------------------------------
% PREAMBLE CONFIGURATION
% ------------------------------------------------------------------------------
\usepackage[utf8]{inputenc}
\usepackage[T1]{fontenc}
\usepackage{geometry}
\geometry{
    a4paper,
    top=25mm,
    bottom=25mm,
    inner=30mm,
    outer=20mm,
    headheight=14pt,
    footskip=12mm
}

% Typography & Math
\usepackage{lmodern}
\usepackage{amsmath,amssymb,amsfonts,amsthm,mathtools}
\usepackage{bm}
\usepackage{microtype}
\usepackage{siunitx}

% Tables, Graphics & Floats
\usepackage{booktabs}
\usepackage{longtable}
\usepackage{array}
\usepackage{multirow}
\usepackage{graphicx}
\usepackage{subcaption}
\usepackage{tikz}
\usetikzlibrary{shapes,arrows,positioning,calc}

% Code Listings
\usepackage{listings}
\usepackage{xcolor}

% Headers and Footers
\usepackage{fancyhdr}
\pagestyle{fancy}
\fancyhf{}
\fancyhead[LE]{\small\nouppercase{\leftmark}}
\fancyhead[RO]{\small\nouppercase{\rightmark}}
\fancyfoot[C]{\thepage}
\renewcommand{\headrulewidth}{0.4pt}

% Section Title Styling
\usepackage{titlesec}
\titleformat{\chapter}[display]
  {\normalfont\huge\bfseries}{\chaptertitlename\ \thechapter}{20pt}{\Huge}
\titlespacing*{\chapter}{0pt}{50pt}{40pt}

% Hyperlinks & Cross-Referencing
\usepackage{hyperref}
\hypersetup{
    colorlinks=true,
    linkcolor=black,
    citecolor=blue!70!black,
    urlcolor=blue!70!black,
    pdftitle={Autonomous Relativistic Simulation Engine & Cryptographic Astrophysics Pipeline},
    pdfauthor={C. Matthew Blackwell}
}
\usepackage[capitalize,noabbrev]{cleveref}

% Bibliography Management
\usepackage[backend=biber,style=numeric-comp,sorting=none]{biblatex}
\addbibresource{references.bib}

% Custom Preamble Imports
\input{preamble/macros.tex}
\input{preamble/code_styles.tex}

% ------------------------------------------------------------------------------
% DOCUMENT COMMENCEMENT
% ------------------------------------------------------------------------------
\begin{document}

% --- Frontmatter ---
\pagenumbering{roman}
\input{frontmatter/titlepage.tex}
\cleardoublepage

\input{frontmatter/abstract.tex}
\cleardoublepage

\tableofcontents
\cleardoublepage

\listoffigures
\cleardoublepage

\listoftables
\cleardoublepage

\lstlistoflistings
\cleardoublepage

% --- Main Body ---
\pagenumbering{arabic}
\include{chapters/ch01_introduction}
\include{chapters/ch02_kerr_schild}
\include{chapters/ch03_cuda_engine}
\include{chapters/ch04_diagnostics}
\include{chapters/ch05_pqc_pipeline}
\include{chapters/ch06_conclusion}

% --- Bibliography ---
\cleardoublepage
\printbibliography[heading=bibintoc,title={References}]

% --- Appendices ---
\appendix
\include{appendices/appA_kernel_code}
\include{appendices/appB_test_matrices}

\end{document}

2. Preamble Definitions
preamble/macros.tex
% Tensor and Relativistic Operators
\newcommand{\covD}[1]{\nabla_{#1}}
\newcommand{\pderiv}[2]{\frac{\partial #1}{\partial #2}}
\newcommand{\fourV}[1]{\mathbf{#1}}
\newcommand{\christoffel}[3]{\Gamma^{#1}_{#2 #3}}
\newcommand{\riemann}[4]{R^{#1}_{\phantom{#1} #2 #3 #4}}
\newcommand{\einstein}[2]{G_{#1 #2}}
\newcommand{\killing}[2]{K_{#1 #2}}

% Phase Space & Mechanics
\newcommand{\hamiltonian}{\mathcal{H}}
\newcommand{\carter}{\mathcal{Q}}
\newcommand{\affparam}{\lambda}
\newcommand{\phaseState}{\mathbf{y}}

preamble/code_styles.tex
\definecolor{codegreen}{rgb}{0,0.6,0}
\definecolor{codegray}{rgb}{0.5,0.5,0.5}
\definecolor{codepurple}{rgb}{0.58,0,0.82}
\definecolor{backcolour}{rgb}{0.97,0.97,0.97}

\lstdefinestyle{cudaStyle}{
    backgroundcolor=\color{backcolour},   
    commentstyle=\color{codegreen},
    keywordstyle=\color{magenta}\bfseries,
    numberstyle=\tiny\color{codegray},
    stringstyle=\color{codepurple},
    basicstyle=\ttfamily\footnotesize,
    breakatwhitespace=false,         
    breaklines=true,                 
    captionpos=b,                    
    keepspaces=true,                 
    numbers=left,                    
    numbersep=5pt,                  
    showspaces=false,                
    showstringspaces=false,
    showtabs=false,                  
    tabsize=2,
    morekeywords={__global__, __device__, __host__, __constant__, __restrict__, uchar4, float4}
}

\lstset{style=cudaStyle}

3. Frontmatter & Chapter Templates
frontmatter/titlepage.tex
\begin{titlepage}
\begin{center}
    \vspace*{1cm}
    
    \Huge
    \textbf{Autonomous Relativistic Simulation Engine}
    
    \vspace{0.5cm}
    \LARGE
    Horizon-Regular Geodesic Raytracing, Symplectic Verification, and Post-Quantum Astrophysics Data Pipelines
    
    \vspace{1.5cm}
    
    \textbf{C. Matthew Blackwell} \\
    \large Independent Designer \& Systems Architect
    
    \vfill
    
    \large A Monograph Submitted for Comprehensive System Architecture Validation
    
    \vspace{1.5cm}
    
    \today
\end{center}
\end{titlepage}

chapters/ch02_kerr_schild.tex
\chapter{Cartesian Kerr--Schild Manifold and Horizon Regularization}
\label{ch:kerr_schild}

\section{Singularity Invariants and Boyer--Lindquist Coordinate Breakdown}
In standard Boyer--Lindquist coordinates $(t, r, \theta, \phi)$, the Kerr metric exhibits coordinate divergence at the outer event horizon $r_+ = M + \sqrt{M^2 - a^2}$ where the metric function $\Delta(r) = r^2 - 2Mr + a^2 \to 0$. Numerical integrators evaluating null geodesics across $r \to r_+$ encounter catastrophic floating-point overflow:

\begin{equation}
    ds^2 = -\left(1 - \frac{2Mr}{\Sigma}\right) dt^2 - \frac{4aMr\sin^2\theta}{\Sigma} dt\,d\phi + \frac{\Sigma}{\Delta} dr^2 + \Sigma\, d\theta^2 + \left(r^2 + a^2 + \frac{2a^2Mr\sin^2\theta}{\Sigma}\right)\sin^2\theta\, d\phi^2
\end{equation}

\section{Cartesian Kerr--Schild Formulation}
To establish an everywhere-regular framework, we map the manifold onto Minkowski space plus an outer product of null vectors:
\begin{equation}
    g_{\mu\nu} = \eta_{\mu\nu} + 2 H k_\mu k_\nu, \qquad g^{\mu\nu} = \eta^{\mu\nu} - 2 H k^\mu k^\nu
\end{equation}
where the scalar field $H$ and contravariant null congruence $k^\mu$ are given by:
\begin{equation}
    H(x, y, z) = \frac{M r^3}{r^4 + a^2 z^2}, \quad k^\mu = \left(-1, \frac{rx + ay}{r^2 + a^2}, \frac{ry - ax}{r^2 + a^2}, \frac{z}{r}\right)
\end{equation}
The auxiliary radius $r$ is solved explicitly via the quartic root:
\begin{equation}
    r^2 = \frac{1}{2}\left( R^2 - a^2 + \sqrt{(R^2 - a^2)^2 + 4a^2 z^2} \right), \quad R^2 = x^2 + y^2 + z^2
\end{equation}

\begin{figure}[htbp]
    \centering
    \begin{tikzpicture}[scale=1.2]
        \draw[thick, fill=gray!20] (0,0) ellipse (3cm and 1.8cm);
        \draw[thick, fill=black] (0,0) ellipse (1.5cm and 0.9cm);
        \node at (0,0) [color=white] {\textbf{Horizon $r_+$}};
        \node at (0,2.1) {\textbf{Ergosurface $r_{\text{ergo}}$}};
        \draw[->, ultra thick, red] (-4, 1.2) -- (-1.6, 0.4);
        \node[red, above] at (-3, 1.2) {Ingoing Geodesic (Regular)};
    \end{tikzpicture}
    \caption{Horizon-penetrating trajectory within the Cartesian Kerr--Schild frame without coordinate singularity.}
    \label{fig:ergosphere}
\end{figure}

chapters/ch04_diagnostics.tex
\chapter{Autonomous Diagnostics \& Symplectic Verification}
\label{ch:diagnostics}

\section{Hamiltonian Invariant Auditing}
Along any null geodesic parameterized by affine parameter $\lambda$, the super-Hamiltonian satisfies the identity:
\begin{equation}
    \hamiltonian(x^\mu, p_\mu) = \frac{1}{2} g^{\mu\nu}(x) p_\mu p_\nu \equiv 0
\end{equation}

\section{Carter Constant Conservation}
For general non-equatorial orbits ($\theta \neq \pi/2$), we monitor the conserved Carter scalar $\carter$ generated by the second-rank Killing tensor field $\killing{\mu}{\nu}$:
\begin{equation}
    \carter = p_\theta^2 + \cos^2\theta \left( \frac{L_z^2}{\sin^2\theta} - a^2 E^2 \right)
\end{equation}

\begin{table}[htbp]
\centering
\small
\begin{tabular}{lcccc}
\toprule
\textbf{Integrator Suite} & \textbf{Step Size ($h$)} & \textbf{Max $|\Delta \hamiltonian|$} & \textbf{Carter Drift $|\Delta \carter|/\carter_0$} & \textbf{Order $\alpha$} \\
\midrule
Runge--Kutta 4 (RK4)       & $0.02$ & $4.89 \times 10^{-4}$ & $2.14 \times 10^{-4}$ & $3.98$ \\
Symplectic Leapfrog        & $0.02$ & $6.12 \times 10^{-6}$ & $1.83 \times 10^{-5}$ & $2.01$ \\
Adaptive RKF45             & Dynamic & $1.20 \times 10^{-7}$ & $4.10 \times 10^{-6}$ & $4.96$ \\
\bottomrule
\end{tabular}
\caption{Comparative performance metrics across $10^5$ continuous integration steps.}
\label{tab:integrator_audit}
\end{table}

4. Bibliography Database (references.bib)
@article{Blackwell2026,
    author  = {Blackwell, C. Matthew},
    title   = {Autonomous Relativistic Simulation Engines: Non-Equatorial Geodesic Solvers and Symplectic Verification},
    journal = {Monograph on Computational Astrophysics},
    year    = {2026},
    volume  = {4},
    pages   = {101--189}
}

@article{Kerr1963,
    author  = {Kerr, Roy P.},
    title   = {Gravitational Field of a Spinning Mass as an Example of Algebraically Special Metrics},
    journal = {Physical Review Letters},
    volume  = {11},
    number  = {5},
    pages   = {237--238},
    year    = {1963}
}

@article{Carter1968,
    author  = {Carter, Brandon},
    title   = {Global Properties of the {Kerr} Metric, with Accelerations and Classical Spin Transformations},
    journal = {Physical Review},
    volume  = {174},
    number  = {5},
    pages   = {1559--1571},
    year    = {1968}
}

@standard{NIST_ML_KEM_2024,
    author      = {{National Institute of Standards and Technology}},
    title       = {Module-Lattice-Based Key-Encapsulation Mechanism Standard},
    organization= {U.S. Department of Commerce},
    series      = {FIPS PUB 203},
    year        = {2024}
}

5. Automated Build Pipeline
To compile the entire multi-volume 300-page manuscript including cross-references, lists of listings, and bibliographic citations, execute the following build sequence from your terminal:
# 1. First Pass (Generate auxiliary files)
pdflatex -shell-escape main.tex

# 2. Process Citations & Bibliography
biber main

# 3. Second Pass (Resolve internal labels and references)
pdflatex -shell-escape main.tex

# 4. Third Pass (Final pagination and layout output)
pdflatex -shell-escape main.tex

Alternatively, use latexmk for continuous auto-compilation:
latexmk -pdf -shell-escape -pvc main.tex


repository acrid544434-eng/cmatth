\chapter{Autonomous Diagnostics \& Symplectic Verification}
\label{ch:diagnostics}

\section{Hamiltonian Invariant Auditing}
Along any null geodesic parameterized by affine parameter $\lambda$, the super-Hamiltonian satisfies the identity:
\begin{equation}
    \hamiltonian(x^\mu, p_\mu) = \frac{1}{2} g^{\mu\nu}(x) p_\mu p_\nu \equiv 0
\end{equation}

\section{Carter Constant Conservation}
For general non-equatorial orbits ($\theta \neq \pi/2$), we monitor the conserved Carter scalar $\carter$ generated by the second-rank Killing tensor field $\killing{\mu}{\nu}$:
\begin{equation}
    \carter = p_\theta^2 + \cos^2\theta \left( \frac{L_z^2}{\sin^2\theta} - a^2 E^2 \right)
\end{equation}

