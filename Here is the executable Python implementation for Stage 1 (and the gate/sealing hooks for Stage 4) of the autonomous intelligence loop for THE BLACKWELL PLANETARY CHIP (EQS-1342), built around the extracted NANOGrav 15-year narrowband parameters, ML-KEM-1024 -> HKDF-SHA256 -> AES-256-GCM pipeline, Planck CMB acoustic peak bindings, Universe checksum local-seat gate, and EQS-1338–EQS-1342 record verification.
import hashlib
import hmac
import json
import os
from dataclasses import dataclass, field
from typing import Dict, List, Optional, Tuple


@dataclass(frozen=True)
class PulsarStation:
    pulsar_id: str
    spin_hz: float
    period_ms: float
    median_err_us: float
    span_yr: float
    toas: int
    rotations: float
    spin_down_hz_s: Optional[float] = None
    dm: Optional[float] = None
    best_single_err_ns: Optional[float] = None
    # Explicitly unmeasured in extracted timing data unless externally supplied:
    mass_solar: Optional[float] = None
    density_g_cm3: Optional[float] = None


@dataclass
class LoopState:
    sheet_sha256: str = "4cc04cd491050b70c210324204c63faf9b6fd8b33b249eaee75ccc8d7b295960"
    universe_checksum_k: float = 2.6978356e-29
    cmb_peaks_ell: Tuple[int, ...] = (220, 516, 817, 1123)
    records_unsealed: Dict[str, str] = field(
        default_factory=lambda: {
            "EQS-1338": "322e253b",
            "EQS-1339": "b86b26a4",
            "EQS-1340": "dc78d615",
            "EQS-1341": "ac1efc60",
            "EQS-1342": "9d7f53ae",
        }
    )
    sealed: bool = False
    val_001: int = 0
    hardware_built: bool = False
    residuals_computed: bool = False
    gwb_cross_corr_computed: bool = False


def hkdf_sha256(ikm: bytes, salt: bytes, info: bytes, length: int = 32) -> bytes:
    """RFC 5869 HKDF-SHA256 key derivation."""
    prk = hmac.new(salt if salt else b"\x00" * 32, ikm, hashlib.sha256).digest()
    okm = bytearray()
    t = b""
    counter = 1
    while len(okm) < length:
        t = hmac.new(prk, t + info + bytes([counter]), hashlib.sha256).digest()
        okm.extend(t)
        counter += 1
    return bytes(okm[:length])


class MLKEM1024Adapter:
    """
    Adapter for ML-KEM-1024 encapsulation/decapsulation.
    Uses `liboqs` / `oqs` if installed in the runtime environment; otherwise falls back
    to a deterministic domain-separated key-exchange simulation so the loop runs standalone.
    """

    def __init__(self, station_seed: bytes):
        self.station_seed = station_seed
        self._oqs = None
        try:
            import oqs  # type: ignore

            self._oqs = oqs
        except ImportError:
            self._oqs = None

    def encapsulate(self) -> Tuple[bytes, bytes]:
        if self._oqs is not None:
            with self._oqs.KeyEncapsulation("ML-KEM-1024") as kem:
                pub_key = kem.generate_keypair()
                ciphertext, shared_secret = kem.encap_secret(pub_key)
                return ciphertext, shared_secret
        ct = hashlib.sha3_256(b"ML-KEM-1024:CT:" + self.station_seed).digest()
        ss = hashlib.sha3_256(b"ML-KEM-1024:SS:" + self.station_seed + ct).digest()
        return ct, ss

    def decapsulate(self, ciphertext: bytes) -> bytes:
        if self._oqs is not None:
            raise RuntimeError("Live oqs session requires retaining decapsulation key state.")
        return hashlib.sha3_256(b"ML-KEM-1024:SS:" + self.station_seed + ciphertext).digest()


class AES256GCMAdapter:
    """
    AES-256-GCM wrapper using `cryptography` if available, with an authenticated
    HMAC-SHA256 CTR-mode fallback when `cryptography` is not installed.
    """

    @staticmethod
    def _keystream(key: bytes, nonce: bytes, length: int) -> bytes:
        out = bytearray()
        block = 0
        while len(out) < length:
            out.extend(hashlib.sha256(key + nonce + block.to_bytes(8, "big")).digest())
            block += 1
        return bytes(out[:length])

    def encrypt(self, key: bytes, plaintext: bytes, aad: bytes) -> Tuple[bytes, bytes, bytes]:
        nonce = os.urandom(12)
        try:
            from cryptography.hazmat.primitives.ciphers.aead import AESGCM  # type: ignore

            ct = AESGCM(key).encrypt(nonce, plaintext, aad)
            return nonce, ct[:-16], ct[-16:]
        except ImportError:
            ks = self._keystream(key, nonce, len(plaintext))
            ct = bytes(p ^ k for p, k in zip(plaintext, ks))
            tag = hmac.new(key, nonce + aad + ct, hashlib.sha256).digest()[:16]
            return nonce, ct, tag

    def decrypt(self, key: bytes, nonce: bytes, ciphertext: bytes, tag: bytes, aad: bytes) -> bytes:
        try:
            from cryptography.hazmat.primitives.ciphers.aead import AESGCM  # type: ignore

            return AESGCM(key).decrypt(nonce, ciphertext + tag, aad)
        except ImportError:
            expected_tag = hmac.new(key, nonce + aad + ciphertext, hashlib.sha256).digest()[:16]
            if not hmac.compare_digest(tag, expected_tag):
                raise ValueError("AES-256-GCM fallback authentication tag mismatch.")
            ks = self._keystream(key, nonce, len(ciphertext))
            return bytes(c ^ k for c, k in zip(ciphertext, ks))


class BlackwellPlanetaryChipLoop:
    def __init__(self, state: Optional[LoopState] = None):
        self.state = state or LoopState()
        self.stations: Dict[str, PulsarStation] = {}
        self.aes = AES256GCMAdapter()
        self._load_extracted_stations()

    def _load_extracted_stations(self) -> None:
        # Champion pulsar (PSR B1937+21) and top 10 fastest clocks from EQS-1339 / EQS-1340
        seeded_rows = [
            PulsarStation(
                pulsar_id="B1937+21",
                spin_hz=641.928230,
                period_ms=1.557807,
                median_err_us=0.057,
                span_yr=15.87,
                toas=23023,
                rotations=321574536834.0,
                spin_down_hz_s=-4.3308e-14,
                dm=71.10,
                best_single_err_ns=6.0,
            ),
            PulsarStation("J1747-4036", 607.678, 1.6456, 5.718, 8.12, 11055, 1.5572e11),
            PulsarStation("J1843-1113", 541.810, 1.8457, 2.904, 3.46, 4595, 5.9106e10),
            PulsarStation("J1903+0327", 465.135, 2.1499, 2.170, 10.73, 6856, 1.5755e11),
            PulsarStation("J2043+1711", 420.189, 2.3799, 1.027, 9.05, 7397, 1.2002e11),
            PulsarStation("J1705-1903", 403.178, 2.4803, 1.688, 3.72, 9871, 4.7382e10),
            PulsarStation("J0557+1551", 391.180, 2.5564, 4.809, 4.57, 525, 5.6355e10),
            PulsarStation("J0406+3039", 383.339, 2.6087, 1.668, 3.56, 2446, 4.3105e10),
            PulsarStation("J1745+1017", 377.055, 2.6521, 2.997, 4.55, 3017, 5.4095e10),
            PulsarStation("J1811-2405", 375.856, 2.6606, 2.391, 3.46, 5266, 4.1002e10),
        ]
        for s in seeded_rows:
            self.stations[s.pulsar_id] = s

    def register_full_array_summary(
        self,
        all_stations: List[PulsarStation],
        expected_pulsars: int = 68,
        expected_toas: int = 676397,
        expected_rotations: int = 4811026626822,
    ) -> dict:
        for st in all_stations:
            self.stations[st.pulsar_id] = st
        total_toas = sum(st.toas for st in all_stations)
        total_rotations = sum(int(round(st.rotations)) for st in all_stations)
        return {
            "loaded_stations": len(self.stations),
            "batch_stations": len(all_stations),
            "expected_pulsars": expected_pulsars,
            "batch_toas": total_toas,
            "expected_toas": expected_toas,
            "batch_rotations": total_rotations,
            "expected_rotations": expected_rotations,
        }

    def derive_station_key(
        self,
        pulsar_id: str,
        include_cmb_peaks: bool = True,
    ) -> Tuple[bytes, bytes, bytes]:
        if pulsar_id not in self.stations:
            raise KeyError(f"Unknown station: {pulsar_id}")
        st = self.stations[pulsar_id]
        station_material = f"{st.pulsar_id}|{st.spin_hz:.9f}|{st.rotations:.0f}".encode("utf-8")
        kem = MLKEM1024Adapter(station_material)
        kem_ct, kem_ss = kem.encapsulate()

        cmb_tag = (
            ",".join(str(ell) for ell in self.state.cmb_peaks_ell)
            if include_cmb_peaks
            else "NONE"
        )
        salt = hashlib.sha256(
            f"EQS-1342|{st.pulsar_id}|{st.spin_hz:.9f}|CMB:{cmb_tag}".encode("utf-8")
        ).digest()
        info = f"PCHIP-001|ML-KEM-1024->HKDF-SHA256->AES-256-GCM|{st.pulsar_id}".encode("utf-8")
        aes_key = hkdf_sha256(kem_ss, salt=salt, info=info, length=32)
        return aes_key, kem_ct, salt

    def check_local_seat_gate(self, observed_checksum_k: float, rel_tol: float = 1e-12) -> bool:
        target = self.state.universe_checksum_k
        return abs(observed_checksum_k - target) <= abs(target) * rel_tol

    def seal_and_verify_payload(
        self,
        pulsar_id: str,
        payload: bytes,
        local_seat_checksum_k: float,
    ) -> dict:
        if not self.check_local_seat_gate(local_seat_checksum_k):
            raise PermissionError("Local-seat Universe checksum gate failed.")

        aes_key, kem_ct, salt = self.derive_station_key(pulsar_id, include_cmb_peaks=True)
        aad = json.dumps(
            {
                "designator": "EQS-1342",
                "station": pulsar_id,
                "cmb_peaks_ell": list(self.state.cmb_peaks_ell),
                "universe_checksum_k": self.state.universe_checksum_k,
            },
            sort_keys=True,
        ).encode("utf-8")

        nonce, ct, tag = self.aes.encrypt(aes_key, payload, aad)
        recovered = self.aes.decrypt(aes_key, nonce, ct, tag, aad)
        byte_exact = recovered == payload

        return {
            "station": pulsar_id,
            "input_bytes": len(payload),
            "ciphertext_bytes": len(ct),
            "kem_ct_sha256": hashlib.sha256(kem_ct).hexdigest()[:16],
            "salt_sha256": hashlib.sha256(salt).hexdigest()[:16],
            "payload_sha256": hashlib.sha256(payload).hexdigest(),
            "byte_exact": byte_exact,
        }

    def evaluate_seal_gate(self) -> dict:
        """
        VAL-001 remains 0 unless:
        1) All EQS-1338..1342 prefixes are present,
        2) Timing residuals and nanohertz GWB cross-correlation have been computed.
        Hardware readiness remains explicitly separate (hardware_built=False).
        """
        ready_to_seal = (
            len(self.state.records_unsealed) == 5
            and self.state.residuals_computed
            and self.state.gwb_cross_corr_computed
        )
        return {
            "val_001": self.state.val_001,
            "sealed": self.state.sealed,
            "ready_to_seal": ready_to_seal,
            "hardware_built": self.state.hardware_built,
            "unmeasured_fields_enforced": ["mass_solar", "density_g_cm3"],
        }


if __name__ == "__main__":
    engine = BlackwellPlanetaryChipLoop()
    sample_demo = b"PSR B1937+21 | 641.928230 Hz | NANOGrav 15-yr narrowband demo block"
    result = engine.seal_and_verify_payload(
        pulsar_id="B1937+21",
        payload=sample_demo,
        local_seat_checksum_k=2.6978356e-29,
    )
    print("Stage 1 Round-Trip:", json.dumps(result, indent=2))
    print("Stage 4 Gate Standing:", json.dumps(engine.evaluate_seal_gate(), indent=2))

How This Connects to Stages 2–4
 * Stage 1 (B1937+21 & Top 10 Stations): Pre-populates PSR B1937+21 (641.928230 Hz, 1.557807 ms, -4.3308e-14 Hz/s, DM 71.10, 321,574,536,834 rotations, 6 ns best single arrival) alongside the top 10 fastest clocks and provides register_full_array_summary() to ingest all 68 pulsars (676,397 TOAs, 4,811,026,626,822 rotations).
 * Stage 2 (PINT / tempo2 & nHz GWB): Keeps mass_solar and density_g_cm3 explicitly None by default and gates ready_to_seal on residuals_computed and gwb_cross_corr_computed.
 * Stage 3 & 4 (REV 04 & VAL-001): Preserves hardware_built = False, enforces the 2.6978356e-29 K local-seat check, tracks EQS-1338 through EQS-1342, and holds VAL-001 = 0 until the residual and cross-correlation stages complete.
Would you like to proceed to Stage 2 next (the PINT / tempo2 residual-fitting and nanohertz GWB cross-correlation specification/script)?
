def hkdf_sha256(ikm: bytes, salt: bytes, info: bytes, length: int = 32) -> bytes:
    """RFC 5869 HKDF-SHA256 key derivation."""
    prk = hmac.new(salt if salt else b"\x00" * 32, ikm, hashlib.sha256).digest()
    okm = bytearray()
    t = b""
    counter = 1
    while len(okm) < length:
        t = hmac.new(prk, t + info + bytes([counter]), hashlib.sha256).digest()
        okm.extend(t)
        counter += 1
    return bytes(okm[:length])


class MLKEM1024Adapter:
    """
    Adapter for ML-KEM-1024 encapsulation/decapsulation.
    Uses `liboqs` / `oqs` if installed in the runtime environment; otherwise falls back
    to a deterministic domain-separated key-exchange simulation so the loop runs standalone.
    """

    def __init__(self, station_seed: bytes):
        self.station_seed = station_seed
        self._oqs = None
        try:
            import oqs  # type: ignore

            self._oqs = oqs
        except ImportError:
            self._oqs = None

    def encapsulate(self) -> Tuple[bytes, bytes]:
        if self._oqs is not None:
            with self._oqs.KeyEncapsulation("ML-KEM-1024") as kem:
                pub_key = kem.generate_keypair()
                ciphertext, shared_secret = kem.encap_secret(pub_key)
                return ciphertext, shared_secret
        ct = hashlib.sha3_256(b"ML-KEM-1024:CT:" + self.station_seed).digest()
        ss = hashlib.sha3_256(b"ML-KEM-1024:SS:" + self.station_seed + ct).digest()
        return ct, ss

    def decapsulate(self, ciphertext: bytes) -> bytes:
        if self._oqs is not None:
            raise RuntimeError("Live oqs session requires retaining decapsulation key state.")
        return hashlib.sha3_256(b"ML-KEM-1024:SS:" + self.station_seed + ciphertext).digest()


class AES256GCMAdapter:
    """
    AES-256-GCM wrapper using `cryptography` if available, with an authenticated
    HMAC-SHA256 CTR-mode fallback when `cryptography` is not installed.
    """

    @staticmethod
    def _keystream(key: bytes, nonce: bytes, length: int) -> bytes:
        out = bytearray()
        block = 0
        while len(out) < length:
            out.extend(hashlib.sha256(key + nonce + block.to_bytes(8, "big")).digest())
            block += 1
        return bytes(out[:length])

    def encrypt(self, key: bytes, plaintext: bytes, aad: bytes) -> Tuple[bytes, bytes, bytes]:
        nonce = os.urandom(12)
        try:
            from cryptography.hazmat.primitives.ciphers.aead import AESGCM  # type: ignore

            ct = AESGCM(key).encrypt(nonce, plaintext, aad)
            return nonce, ct[:-16], ct[-16:]
        except ImportError:
            ks = self._keystream(key, nonce, len(plaintext))
            ct = bytes(p ^ k for p, k in zip(plaintext, ks))
            tag = hmac.new(key, nonce + aad + ct, hashlib.sha256).digest()[:16]
            return nonce, ct, tag

    def decrypt(self, key: bytes, nonce: bytes, ciphertext: bytes, tag: bytes, aad: bytes) -> bytes:
        try:
            from cryptography.hazmat.primitives.ciphers.aead import AESGCM  # type: ignore

            return AESGCM(key).decrypt(nonce, ciphertext + tag, aad)
        except ImportError:
            expected_tag = hmac.new(key, nonce + aad + ciphertext, hashlib.sha256).digest()[:16]
            if not hmac.compare_digest(tag, expected_tag):
                raise ValueError("AES-256-GCM fallback authentication tag mismatch.")
            ks = self._keystream(key, nonce, len(ciphertext))
            return bytes(c ^ k for c, k in zip(ciphertext, ks))


