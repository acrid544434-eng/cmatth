% III. Spherical Harmonic Expansion
% ---------------------------------------------------------
\section{Spherical Harmonic Expansion \& Telemetry Mapping}
Local control potentials near $L_2$ are expanded in spherical coordinates using bounded radial basis functions $R_l(r)$ and normalized spherical harmonics $Y_l^m(\theta, \phi)$:
\begin{equation}
\Phi(r,\theta,\phi; D(t)) = \sum_{l=0}^{L_{\text{max}}} \sum_{m=-l}^{l} c_{lm}(D(t))\, R_l(r)\, Y_l^m(\theta,\phi)
\end{equation}
Raw observational inputs $R_i(t)$ pass through key-stretching functions $\mathcal{H}_k$ to generate secure, bounded amplitude coefficients:
\begin{equation}
c_{lm}(D(t)) = \kappa \, \tanh \left( \frac{1}{\sigma_{\text{noise}}} \sum_{i} \mathcal{H}_k(R_i(t)) \, w_i \, Y_l^{m*}(\theta_i, \phi_i) \right)
\end{equation}

