import numpy as np
from typing import List, Dict, Optional

class TrustEngine:
    """
    Implements discrete-time approximation matrices for continuous trust integrals,
    eigenvector centrality weighting, non-linear penalties, and cryptographic
    proof-of-penance rehabilitation loops.
    """
    def __init__(
        self, 
        node_id: str,
        alpha: float = 0.4, 
        beta: float = 0.5, 
        gamma: float = 1.2, 
        decay_lambda: float = 0.05, 
        penalty_k: float = 1.5,
        quarantine_threshold: float = 0.15
    ):
        self.node_id = node_id
        self.alpha = alpha
        self.beta = beta
        self.gamma = gamma
        self.decay_lambda = decay_lambda
        self.penalty_k = penalty_k
        self.quarantine_threshold = quarantine_threshold
        
        # Internal state metrics
        self.trust_score: float = 1.0
        self.is_quarantined: bool = False
        self.penance_ledger: List[Dict[str, float]] = []

    def compute_exponential_penalty(self, delta_a: float) -> float:
        """Computes the exponential penalty escalation P_i(tau)."""
        return np.exp(self.penalty_k * delta_a) - 1.0

    def step_discrete_integral(
        self, 
        time_steps: np.ndarray, 
        contributions: np.ndarray, 
        validations: np.ndarray, 
        anomalies: np.ndarray
    ) -> float:
        """
        Approximates the continuous integro-differential trust equation using 
        discrete-time trapezoidal summation across temporal tracking intervals:
        T_i(t) = sum_{k} e^(-λ(t - tau_k)) * [alpha*C(tau) + beta*V(tau) - gamma*P(tau)] * delta_tau
        """
        if len(time_steps) < 2:
            return self.trust_score

        t_current = time_steps[-1]
        dt = np.gradient(time_steps)
        
        net_densities = np.zeros_like(time_steps)
        for idx in range(len(time_steps)):
            p_tau = self.compute_exponential_penalty(anomalies[idx])
            net_densities[idx] = (
                (self.alpha * contributions[idx]) + 
                (self.beta * validations[idx]) - 
                (self.gamma * p_tau)
            )
            
        # Apply temporal exponential decay weight to historical time steps
        decay_weights = np.exp(-self.decay_lambda * (t_current - time_steps))
        integrand_values = decay_weights * net_densities
        
        # Numerical integration approximation via trapezoidal sum
        integral_sum = np.trapz(integrand_values, time_steps)
        
        # Apply safety floor clamp [0.0, 1.0 max normalized baseline bounds]
        calculated_score = max(0.0, min(1.0, integral_sum))
        
        self.trust_score = calculated_score
        self._evaluate_quarantine_status()
        return self.trust_score

    def update_eigenvector_centrality(self, neighbor_trusts: np.ndarray, interaction_weights: np.ndarray, eigenvalue_mu: float) -> float:
        """
        Computes localized peer validation weight: V_i = (1 / mu) * sum(w_ji * T_j)
        """
        if eigenvalue_mu == 0 or len(neighbor_trusts) == 0:
            return 0.0
        
        weighted_sum = np.dot(interaction_weights, neighbor_trusts)
        v_score = weighted_sum / eigenvalue_mu
        return float(v_score)

    def _evaluate_quarantine_status(self) -> None:
        """Triggers system-level lockdown if trust drops beneath threshold."""
        if self.trust_score < self.quarantine_threshold:
            self.is_quarantined = True
        elif self.trust_score >= (self.quarantine_threshold * 1.5) and not self.penance_ledger:
            self.is_quarantined = False

