        Allows a quarantined node to execute an asymmetric 'proof of penance' 
        rehabilitation sequence. Rebuilds trust linearly via verifiable offline 
        work units and trusted peer signatures.
        """
        if not self.is_quarantined:
            print(f"Node {self.node_id} is not in quarantine; penance protocol bypassed.")
            return True

        # Require strict validation parameters for penance acceptance
        if verified_contribution_hours >= 10.0 and peer_vouchers >= 3:
            rehabilitation_delta = 0.05 * verified_contribution_hours + (0.02 * peer_vouchers)
            self.trust_score = min(self.quarantine_threshold * 2.0, self.trust_score + rehabilitation_delta)
            
            self.penance_ledger.append({
                "hours": verified_contribution_hours,
                "vouchers": float(peer_vouchers),
                "restored_weight": rehabilitation_delta
            })

            # Check if threshold is cleared to lift quarantine
            if self.trust_score >= self.quarantine_threshold:
                self.is_quarantined = False
                print(f"✓ Node {self.node_id} successfully cleared quarantine via Proof of Penance.")
            return True
            
        print(f"✗ Proof of penance rejected for node {self.node_id}: Insufficient work units or peer vouchers.")
        return False

