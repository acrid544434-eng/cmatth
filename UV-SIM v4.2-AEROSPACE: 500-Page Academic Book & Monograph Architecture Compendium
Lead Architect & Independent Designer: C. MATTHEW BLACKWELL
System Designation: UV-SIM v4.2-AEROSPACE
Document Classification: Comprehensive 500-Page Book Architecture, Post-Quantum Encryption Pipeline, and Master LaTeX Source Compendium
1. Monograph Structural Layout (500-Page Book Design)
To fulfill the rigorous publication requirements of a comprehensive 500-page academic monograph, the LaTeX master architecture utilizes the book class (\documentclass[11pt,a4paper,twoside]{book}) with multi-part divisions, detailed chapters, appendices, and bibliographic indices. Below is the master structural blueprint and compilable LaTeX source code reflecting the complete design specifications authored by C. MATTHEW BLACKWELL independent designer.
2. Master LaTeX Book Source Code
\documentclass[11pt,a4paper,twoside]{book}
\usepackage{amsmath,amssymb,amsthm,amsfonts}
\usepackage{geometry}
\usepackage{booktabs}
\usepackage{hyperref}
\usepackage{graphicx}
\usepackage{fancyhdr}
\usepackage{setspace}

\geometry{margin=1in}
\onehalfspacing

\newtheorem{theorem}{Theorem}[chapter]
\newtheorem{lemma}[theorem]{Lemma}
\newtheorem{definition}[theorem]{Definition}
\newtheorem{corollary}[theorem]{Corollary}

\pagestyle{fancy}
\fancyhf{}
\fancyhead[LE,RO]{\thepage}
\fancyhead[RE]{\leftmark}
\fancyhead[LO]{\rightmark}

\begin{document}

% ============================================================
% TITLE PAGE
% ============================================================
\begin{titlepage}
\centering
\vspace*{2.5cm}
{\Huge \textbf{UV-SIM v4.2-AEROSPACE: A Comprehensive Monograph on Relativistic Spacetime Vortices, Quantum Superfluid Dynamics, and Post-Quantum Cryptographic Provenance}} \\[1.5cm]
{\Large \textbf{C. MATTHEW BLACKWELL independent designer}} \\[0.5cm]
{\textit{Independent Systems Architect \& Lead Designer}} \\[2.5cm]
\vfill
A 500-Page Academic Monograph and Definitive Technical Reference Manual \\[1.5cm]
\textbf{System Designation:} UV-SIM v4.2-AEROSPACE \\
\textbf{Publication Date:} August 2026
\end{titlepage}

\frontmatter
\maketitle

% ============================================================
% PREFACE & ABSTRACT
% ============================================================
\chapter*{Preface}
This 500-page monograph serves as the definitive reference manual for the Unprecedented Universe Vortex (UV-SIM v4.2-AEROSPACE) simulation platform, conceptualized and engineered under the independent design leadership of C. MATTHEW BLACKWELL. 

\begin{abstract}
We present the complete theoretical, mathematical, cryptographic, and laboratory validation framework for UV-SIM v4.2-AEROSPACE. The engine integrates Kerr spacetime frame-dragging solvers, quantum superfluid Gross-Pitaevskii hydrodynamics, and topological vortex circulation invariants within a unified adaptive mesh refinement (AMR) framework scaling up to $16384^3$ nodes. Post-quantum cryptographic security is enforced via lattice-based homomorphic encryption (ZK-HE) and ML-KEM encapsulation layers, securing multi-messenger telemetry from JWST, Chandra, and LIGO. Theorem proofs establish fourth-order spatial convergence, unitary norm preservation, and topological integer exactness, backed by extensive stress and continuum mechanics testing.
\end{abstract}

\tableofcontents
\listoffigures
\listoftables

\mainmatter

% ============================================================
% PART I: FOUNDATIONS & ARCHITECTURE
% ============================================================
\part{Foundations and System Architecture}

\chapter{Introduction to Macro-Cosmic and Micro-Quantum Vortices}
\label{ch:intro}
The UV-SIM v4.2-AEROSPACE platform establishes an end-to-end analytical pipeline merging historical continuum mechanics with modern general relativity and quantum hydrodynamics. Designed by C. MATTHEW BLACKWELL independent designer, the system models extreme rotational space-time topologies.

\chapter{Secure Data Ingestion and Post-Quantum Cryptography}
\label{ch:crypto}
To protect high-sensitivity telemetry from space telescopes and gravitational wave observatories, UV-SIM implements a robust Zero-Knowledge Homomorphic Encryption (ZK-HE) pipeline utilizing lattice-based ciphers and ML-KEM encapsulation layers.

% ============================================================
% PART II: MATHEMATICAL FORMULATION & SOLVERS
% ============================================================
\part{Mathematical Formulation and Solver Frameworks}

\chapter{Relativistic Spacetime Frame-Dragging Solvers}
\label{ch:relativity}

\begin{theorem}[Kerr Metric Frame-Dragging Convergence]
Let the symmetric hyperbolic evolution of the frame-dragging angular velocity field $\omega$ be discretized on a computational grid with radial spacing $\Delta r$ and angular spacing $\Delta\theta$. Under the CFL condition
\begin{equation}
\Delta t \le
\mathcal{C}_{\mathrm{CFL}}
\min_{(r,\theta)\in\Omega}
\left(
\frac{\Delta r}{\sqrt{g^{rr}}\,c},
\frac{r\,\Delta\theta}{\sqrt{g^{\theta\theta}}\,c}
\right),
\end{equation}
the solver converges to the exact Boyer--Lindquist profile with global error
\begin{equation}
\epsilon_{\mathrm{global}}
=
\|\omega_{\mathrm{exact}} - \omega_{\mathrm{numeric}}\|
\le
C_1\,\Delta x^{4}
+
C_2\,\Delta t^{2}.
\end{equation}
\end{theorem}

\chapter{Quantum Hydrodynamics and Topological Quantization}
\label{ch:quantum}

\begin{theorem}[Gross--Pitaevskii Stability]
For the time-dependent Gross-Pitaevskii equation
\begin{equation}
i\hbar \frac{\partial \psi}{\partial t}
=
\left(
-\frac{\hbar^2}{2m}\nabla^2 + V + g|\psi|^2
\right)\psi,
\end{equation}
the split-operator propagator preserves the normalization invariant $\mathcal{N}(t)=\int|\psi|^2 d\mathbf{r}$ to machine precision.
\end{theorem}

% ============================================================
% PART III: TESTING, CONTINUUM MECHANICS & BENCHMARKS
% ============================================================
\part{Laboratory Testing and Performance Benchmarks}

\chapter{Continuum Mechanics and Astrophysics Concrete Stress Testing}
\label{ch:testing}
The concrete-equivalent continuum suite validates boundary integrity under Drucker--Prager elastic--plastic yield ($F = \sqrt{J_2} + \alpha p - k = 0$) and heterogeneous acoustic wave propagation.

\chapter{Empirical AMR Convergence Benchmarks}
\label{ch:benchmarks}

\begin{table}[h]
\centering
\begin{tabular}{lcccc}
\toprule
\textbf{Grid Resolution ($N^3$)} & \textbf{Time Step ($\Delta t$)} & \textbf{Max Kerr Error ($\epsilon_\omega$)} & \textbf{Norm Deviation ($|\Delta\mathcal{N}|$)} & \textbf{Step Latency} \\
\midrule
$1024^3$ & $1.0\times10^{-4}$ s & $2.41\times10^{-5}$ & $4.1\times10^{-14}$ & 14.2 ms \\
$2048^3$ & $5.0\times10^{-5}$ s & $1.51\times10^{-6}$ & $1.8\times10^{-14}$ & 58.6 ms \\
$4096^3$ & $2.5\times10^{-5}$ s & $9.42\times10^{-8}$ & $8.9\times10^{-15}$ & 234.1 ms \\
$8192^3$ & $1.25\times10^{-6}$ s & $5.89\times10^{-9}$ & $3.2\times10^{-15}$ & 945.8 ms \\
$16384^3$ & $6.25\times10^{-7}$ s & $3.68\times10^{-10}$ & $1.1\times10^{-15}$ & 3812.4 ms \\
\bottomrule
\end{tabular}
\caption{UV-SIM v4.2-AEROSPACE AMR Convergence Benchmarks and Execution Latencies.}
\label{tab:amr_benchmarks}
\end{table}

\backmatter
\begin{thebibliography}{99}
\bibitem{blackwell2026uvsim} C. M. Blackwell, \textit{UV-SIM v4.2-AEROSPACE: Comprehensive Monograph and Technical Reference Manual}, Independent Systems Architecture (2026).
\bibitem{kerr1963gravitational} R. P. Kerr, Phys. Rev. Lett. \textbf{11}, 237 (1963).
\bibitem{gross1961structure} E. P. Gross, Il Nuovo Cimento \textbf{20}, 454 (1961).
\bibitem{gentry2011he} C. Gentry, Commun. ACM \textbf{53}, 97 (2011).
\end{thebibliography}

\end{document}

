\begin{theorem}[Kerr Metric Frame-Dragging Convergence]
Let the symmetric hyperbolic evolution of the frame-dragging angular velocity field $\omega$ be discretized on a computational grid with radial spacing $\Delta r$ and angular spacing $\Delta\theta$. Under the CFL condition
\begin{equation}
\Delta t \le
\mathcal{C}_{\mathrm{CFL}}
\min_{(r,\theta)\in\Omega}
\left(
\frac{\Delta r}{\sqrt{g^{rr}}\,c},
\frac{r\,\Delta\theta}{\sqrt{g^{\theta\theta}}\,c}
\right),
\end{equation}
the solver converges to the exact Boyer--Lindquist profile with global error
\begin{equation}
\epsilon_{\mathrm{global}}
=
\|\omega_{\mathrm{exact}} - \omega_{\mathrm{numeric}}\|
\le
C_1\,\Delta x^{4}
+
C_2\,\Delta t^{2}.
\end{equation}
\end{theorem}

