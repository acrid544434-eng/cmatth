\chapter{Mathematical Identities}

\section{Tensor Identities}
\[
R_{\mu\nu} = R^\lambda_{\ \mu\lambda\nu}
\]
\[
R = g^{\mu\nu} R_{\mu\nu}
\]

\section{Bianchi Identity}
\[
\nabla_\mu G^{\mu\nu} = 0
\]

\section{Christoffel Symbols}
\[
\Gamma^\rho_{\mu\nu}
= \frac{1}{2} g^{\rho\sigma}
\left(
\partial_\mu g_{\sigma\nu}
+ \partial_\nu g_{\sigma\mu}
- \partial_\sigma g_{\mu\nu}
\right)
\]

\section{Geodesic Equation}
\[
\frac{d^2 x^\mu}{d\tau^2}
+ \Gamma^\mu_{\alpha\beta}
\frac{dx^\alpha}{d\tau}
\frac{dx^\beta}{d\tau}
= 0
\]

\section{Stress-Energy Tensor}
\[
T_{\mu\nu} = -\frac{2}{\sqrt{-g}}
\frac{\delta (\mathcal{L}_m \sqrt{-g})}{\delta g^{\mu\nu}}
\]

