\chapter{Glossary of Terms}

\section*{Adaptive Mesh Refinement (AMR)}
A numerical technique that increases resolution in regions of high curvature or
strong gradients.

\section*{Backreaction}
The influence of quantum vacuum fluctuations on classical spacetime geometry.

\section*{BSSN Formalism}
A reformulation of Einstein’s equations used in numerical relativity.

\section*{Curvature Invariants}
Scalar quantities derived from curvature tensors, used to detect singularities.

\section*{Fully Homomorphic Encryption (FHE)}
An encryption scheme allowing computation on encrypted data.

\section*{Gaia DR3}
Astrometric data from the Gaia mission.

\section*{JWST Radiometry}
Deep-field radiometric measurements from the James Webb Space Telescope.

\section*{LIGO Strain Channels}
Gravitational wave strain measurements.

\section*{LWE Matrices}
Learning With Errors cryptographic matrices used in post-quantum cryptography.

\section*{MOTS}
Marginally Outer Trapped Surface, used to detect horizon formation.

\section*{Planck-Scale Pixelation}
Discretization of spacetime at the Planck length.

\section*{Ricci Tensor}
A contraction of the Riemann tensor describing gravitational curvature.

\section*{Semiclassical Gravity}
A hybrid model combining classical GR with quantum vacuum contributions.

\section*{zk-SNARK}
Zero-Knowledge Succinct Non-Interactive Argument of Knowledge.

