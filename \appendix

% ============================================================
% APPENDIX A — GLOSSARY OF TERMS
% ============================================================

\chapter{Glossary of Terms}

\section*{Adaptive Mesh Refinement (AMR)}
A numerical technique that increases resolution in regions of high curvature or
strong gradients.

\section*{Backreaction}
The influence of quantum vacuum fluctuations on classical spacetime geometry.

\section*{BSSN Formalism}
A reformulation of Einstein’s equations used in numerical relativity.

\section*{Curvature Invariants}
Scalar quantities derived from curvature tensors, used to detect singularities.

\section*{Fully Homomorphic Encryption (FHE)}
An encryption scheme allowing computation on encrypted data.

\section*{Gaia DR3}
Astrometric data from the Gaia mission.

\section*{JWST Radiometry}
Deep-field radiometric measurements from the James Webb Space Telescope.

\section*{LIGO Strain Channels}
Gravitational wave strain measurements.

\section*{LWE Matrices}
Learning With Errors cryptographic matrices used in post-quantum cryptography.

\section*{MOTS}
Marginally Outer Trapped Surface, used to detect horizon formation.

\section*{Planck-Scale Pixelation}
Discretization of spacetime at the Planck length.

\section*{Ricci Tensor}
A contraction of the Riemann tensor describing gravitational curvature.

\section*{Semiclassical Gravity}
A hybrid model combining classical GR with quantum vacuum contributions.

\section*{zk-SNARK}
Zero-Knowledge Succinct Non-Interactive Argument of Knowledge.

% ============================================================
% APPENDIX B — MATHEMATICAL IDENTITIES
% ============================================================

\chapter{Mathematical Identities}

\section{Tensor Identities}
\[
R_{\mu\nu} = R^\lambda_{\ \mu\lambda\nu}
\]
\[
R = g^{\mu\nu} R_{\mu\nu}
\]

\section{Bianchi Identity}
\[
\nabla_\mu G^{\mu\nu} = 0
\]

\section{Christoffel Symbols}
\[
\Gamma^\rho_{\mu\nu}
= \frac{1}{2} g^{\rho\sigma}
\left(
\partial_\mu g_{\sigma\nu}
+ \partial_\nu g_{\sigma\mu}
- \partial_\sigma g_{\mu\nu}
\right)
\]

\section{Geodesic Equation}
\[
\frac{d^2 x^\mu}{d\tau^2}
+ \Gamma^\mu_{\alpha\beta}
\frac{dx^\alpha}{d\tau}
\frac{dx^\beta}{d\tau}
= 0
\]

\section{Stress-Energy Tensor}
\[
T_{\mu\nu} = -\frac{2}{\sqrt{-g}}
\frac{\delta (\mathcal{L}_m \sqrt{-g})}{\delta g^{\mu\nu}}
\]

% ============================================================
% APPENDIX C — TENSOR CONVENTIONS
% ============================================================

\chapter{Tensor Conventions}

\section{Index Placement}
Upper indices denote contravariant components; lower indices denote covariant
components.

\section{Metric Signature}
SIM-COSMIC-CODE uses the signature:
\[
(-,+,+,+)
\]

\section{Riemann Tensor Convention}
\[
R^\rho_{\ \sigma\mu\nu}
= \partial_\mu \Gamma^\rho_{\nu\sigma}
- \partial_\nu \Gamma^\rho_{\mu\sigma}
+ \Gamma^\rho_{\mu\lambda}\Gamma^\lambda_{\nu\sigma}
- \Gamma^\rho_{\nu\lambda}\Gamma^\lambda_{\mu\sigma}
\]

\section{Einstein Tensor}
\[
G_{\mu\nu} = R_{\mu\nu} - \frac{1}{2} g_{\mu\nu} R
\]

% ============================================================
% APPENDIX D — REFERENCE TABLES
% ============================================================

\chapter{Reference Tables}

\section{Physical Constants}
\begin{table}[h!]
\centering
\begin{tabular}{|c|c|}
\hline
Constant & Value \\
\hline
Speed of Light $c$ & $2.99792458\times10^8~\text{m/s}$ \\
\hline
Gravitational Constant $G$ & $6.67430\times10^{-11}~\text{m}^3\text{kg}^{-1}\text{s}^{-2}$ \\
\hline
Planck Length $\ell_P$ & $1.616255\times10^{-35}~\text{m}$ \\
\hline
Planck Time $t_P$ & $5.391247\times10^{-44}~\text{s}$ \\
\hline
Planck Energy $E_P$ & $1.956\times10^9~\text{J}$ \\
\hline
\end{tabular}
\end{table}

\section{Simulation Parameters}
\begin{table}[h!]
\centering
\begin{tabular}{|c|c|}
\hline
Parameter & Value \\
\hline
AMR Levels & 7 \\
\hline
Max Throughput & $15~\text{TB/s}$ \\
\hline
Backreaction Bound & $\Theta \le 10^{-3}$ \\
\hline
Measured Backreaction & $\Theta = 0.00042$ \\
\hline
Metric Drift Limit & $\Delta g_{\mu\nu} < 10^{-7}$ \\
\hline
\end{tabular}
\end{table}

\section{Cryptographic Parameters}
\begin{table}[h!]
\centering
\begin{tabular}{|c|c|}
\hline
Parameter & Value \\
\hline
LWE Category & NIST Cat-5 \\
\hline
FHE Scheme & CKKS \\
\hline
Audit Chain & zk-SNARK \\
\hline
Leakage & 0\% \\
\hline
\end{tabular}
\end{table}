\chapter{Tensor Conventions}

\section{Index Placement}
Upper indices denote contravariant components; lower indices denote covariant
components.

\section{Metric Signature}
SIM-COSMIC-CODE uses the signature:
\[
(-,+,+,+)
\]

\section{Riemann Tensor Convention}
\[
R^\rho_{\ \sigma\mu\nu}
= \partial_\mu \Gamma^\rho_{\nu\sigma}
- \partial_\nu \Gamma^\rho_{\mu\sigma}
+ \Gamma^\rho_{\mu\lambda}\Gamma^\lambda_{\nu\sigma}
- \Gamma^\rho_{\nu\lambda}\Gamma^\lambda_{\mu\sigma}
\]

\section{Einstein Tensor}
\[
G_{\mu\nu} = R_{\mu\nu} - \frac{1}{2} g_{\mu\nu} R
\]

