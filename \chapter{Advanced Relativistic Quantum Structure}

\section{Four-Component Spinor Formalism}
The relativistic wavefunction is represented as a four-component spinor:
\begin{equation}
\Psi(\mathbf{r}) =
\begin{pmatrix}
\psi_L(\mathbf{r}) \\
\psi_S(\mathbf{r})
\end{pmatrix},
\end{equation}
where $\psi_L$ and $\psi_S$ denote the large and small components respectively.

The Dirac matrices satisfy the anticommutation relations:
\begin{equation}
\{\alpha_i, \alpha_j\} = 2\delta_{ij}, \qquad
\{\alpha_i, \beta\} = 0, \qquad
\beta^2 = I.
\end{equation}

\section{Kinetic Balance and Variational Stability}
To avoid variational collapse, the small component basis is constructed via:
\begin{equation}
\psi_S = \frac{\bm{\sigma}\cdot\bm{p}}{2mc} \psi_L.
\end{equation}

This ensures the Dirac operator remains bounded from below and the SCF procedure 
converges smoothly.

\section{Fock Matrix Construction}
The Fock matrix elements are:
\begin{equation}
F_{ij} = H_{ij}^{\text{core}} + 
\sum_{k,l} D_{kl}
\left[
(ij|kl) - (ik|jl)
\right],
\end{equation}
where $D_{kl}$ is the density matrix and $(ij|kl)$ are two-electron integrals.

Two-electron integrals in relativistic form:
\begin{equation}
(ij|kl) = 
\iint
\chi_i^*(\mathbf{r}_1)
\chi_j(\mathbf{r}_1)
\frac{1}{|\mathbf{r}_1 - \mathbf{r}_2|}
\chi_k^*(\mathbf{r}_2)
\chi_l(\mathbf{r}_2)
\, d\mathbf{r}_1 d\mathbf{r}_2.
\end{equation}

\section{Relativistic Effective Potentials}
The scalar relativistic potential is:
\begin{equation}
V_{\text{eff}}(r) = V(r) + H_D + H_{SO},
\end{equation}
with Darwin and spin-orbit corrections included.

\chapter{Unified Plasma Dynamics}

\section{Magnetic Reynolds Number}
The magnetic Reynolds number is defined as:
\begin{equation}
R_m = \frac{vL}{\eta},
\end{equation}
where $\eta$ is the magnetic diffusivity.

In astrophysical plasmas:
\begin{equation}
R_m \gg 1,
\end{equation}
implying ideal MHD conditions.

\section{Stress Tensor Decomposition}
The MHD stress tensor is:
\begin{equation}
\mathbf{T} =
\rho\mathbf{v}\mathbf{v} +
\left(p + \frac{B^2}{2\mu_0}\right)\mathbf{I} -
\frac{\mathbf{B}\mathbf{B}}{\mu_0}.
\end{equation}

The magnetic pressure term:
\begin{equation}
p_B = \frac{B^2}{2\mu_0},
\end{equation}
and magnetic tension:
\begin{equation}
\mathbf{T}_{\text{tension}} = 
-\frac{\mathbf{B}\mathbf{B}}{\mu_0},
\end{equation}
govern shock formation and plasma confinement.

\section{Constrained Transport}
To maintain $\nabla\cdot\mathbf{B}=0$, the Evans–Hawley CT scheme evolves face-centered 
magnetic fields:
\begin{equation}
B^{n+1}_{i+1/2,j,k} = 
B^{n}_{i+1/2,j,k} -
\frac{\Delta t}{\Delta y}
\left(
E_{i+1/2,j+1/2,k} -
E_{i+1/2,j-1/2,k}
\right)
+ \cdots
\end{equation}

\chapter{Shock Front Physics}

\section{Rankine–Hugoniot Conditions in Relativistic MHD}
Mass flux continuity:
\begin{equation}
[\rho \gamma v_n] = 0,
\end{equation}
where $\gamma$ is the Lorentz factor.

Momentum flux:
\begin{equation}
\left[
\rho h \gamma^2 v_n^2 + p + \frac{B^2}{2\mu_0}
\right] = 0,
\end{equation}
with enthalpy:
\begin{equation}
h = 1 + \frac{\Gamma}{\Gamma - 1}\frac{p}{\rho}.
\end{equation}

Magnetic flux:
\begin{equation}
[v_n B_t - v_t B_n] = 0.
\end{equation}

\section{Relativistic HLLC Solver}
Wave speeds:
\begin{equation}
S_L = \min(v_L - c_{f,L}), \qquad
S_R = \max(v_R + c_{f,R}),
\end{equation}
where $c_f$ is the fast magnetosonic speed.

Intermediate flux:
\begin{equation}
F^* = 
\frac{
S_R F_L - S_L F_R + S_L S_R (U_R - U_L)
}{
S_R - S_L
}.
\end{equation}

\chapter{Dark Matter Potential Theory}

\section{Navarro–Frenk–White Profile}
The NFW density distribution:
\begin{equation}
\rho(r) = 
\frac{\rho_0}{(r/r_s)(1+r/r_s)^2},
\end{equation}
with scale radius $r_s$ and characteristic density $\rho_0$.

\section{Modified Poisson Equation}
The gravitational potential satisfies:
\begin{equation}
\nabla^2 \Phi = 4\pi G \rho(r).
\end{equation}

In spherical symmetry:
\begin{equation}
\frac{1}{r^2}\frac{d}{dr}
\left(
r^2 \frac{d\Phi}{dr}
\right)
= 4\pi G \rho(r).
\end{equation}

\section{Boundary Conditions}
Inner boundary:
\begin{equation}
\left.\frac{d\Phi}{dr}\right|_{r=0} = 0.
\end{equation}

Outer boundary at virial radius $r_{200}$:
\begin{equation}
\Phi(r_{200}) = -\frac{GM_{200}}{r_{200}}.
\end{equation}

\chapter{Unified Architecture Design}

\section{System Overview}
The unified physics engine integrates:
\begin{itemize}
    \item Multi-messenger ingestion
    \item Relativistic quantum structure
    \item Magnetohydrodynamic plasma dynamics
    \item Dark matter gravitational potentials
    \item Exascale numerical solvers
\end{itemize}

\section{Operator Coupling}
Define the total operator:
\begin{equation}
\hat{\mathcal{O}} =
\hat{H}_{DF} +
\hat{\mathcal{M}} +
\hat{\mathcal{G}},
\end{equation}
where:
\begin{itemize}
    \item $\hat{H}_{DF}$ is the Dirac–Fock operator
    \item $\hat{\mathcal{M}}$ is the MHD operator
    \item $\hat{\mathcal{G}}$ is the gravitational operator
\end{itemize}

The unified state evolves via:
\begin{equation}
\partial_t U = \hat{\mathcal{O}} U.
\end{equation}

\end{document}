\section{Rankine–Hugoniot Conditions in Relativistic MHD}
Mass flux continuity:
\begin{equation}
[\rho \gamma v_n] = 0,
\end{equation}
where $\gamma$ is the Lorentz factor.

Momentum flux:
\begin{equation}
\left[
\rho h \gamma^2 v_n^2 + p + \frac{B^2}{2\mu_0}
\right] = 0,
\end{equation}
with enthalpy:
\begin{equation}
h = 1 + \frac{\Gamma}{\Gamma - 1}\frac{p}{\rho}.
\end{equation}

Magnetic flux:
\begin{equation}
[v_n B_t - v_t B_n] = 0.
\end{equation}

\section{Relativistic HLLC Solver}
Wave speeds:
\begin{equation}
S_L = \min(v_L - c_{f,L}), \qquad
S_R = \max(v_R + c_{f,R}),
\end{equation}
where $c_f$ is the fast magnetosonic speed.

Intermediate flux:
\begin{equation}
F^* = 
\frac{
S_R F_L - S_L F_R + S_L S_R (U_R - U_L)
}{
S_R - S_L
}.
\end{equation}

\chapter{Dark Matter Potential Theory}

\section{Navarro–Frenk–White Profile}
The NFW density distribution:
\begin{equation}
\rho(r) = 
\frac{\rho_0}{(r/r_s)(1+r/r_s)^2},
\end{equation}
with scale radius $r_s$ and characteristic density $\rho_0$.

\section{Modified Poisson Equation}
The gravitational potential satisfies:
\begin{equation}
\nabla^2 \Phi = 4\pi G \rho(r).
\end{equation}

In spherical symmetry:
\begin{equation}
\frac{1}{r^2}\frac{d}{dr}
\left(
r^2 \frac{d\Phi}{dr}
\right)
= 4\pi G \rho(r).
\end{equation}

\section{Boundary Conditions}
Inner boundary:
\begin{equation}
\left.\frac{d\Phi}{dr}\right|_{r=0} = 0.
\end{equation}

Outer boundary at virial radius $r_{200}$:
\begin{equation}
\Phi(r_{200}) = -\frac{GM_{200}}{r_{200}}.
\end{equation}

