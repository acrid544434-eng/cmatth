\chapter{Advanced Relativistic Quantum Structure}

\section{Four-Component Spinor Formalism}
The relativistic wavefunction is represented as a four-component spinor:
\begin{equation}
\Psi(\mathbf{r}) =
\begin{pmatrix}
\psi_L(\mathbf{r}) \\
\psi_S(\mathbf{r})
\end{pmatrix},
\end{equation}
where $\psi_L$ and $\psi_S$ denote the large and small components respectively.

The Dirac matrices satisfy the anticommutation relations:
\begin{equation}
\{\alpha_i, \alpha_j\} = 2\delta_{ij}, \qquad
\{\alpha_i, \beta\} = 0, \qquad
\beta^2 = I.
\end{equation}

\section{Kinetic Balance and Variational Stability}
To avoid variational collapse, the small component basis is constructed via:
\begin{equation}
\psi_S = \frac{\bm{\sigma}\cdot\bm{p}}{2mc} \psi_L.
\end{equation}

This ensures the Dirac operator remains bounded from below and the SCF procedure 
converges smoothly.

\section{Fock Matrix Construction}
The Fock matrix elements are:
\begin{equation}
F_{ij} = H_{ij}^{\text{core}} + 
\sum_{k,l} D_{kl}
\left[
(ij|kl) - (ik|jl)
\right],
\end{equation}
where $D_{kl}$ is the density matrix and $(ij|kl)$ are two-electron integrals.

Two-electron integrals in relativistic form:
\begin{equation}
(ij|kl) = 
\iint
\chi_i^*(\mathbf{r}_1)
\chi_j(\mathbf{r}_1)
\frac{1}{|\mathbf{r}_1 - \mathbf{r}_2|}
\chi_k^*(\mathbf{r}_2)
\chi_l(\mathbf{r}_2)
\, d\mathbf{r}_1 d\mathbf{r}_2.
\end{equation}

\section{Relativistic Effective Potentials}
The scalar relativistic potential is:
\begin{equation}
V_{\text{eff}}(r) = V(r) + H_D + H_{SO},
\end{equation}
with Darwin and spin-orbit corrections included.

\chapter{Unified Plasma Dynamics}

\section{Magnetic Reynolds Number}
The magnetic Reynolds number is defined as:
\begin{equation}
R_m = \frac{vL}{\eta},
\end{equation}
where $\eta$ is the magnetic diffusivity.

In astrophysical plasmas:
\begin{equation}
R_m \gg 1,
\end{equation}
implying ideal MHD conditions.

\section{Stress Tensor Decomposition}
The MHD stress tensor is:
\begin{equation}
\mathbf{T} =
\rho\mathbf{v}\mathbf{v} +
\left(p + \frac{B^2}{2\mu_0}\right)\mathbf{I} -
\frac{\mathbf{B}\mathbf{B}}{\mu_0}.
\end{equation}

The magnetic pressure term:
\begin{equation}
p_B = \frac{B^2}{2\mu_0},
\end{equation}
and magnetic tension:
\begin{equation}
\mathbf{T}_{\text{tension}} = 
-\frac{\mathbf{B}\mathbf{B}}{\mu_0},
\end{equation}
govern shock formation and plasma confinement.

\section{Constrained Transport}
To maintain $\nabla\cdot\mathbf{B}=0$, the Evans–Hawley CT scheme evolves face-centered 
magnetic fields:
\begin{equation}
B^{n+1}_{i+1/2,j,k} = 
B^{n}_{i+1/2,j,k} -
\frac{\Delta t}{\Delta y}
\left(
E_{i+1/2,j+1/2,k} -
E_{i+1/2,j-1/2,k}
\right)
+ \cdots
\end{equation}

