                  - current_grid[cell_xm].entropy_shannon) / (2.0 * dx);

    double B_sq = current_grid[cell].B_field[0]*current_grid[cell].B_field[0]
                + current_grid[cell].B_field[1]*current_grid[cell].B_field[1]
                + current_grid[cell].B_field[2]*current_grid[cell].B_field[2];

    double T_00 = current_grid[cell].rho_plasma * C_LIGHT * C_LIGHT 
                + (B_sq / (2.0 * 1.256637e-6));

    double R_scalar = (8.0 * PI_VAL * G_CONST / pow(C_LIGHT, 4.0)) * T_00;

    double C_entropy = -alpha_0 * current_grid[cell].entropy_shannon * R_scalar;

    double local_warp = current_grid[cell].metric_warp 
                      + dt * (-(C_LIGHT * C_LIGHT) * dS_dx + C_entropy);

    next_grid[cell].metric_warp = local_warp;

    double dWarp_dx = (next_grid[cell_xp].metric_warp 
                     - next_grid[cell_xm].metric_warp) / (2.0 * dx);

    double local_thrust = -(pow(C_LIGHT, 4.0) / (8.0 * PI_VAL * G_CONST)) 
                        * dWarp_dx * dx * dx * dx;

    atomicAdd(&thrust_accumulator[0], local_thrust);
}
