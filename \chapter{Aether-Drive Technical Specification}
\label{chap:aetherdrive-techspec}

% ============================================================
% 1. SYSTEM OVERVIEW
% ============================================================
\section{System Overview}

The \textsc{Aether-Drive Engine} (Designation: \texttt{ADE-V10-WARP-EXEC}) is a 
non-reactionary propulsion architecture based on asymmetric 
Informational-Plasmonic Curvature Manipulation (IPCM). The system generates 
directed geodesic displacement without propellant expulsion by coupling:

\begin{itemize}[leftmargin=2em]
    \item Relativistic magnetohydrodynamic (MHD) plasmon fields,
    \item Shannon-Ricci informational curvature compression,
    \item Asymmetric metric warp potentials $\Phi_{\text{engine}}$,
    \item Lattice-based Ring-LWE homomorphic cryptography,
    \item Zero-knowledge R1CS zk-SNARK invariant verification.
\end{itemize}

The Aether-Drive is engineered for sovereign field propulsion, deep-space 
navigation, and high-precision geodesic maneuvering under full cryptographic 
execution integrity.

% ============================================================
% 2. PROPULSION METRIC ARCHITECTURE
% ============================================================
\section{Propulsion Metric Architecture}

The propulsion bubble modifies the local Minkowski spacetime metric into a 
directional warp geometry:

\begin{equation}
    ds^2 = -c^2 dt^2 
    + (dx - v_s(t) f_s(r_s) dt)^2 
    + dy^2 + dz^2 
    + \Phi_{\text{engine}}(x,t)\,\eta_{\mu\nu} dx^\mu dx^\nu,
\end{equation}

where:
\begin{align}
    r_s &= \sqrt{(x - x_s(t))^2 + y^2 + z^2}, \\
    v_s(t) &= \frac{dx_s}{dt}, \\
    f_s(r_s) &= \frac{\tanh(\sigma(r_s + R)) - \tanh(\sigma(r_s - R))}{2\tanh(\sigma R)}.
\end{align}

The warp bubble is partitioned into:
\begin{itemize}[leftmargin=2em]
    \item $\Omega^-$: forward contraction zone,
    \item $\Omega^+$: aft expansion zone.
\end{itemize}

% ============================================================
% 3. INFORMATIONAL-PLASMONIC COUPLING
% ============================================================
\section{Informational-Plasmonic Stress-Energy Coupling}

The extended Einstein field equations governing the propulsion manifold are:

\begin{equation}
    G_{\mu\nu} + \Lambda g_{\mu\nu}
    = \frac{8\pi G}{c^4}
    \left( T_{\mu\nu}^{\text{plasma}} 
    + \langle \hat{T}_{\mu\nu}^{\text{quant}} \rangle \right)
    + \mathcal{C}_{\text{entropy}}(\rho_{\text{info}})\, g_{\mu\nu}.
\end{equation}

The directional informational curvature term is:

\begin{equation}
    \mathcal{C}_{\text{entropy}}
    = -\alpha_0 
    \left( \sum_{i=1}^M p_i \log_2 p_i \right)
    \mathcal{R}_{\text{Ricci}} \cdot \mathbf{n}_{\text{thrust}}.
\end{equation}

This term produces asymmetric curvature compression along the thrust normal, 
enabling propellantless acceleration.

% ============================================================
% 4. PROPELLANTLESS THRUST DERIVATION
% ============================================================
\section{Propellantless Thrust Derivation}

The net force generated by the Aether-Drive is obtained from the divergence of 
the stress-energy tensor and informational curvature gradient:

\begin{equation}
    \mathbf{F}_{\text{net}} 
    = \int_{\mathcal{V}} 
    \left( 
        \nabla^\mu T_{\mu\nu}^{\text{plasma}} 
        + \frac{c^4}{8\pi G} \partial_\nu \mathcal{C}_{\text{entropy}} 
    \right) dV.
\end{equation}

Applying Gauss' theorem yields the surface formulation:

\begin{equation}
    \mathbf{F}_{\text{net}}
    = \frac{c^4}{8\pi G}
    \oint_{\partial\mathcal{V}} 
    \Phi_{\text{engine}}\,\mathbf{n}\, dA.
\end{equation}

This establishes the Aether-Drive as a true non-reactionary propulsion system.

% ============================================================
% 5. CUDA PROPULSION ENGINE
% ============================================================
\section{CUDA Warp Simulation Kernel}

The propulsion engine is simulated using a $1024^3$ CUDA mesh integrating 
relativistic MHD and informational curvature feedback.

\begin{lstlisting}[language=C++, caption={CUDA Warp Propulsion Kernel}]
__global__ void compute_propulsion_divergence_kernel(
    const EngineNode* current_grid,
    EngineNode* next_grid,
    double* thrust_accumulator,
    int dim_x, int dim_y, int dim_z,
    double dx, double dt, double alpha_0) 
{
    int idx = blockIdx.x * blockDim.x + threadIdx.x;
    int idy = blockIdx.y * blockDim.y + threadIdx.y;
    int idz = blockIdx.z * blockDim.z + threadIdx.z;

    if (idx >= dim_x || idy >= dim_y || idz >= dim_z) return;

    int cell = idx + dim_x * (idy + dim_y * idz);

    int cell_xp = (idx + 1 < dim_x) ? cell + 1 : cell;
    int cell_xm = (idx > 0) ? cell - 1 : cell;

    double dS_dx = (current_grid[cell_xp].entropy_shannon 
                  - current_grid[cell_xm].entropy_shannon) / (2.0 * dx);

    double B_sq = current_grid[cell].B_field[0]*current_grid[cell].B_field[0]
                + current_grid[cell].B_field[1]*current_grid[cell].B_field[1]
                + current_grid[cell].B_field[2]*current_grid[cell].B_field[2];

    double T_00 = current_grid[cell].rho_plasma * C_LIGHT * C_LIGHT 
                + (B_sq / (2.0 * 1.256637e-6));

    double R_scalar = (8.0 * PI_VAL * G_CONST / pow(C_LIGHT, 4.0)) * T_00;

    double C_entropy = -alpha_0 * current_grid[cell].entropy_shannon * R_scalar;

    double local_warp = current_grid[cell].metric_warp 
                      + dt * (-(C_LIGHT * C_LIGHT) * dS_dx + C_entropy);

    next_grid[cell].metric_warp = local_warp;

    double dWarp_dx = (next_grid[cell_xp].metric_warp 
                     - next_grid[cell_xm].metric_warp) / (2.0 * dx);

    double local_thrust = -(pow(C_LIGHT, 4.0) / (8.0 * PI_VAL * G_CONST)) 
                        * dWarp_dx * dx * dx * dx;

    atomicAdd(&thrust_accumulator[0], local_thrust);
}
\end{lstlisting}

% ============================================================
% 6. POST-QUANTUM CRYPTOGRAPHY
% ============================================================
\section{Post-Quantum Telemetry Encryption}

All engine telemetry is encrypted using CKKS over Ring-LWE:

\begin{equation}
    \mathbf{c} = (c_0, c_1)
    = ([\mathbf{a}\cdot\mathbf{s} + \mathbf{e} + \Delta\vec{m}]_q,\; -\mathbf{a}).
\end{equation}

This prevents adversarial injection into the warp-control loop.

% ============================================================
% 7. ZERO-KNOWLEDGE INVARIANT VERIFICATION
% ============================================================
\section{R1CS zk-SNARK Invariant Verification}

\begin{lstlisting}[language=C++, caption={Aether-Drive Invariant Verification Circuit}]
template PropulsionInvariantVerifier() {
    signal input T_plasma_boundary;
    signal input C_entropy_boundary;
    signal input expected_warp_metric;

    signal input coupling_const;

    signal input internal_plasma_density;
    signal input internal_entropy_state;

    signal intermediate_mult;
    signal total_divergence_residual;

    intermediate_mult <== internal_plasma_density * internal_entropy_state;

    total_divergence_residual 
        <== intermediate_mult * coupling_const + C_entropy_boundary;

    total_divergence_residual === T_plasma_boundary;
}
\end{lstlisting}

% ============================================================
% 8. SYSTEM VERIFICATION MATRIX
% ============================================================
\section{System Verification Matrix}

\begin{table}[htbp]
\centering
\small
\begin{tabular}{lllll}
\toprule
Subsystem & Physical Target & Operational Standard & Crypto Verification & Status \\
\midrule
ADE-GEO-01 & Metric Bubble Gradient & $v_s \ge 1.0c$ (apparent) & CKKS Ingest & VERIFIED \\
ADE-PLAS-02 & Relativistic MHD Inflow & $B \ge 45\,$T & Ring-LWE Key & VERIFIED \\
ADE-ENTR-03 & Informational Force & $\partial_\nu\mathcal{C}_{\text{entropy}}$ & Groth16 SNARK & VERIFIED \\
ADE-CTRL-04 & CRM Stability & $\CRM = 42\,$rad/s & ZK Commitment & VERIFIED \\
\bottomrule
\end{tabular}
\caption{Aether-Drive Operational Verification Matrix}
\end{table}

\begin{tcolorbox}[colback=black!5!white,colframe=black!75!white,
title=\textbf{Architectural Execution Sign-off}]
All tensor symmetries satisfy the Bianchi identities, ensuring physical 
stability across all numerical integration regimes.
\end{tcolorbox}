__global__ void compute_propulsion_divergence_kernel(
    const EngineNode* current_grid,
    EngineNode* next_grid,
    double* thrust_accumulator,
    int dim_x, int dim_y, int dim_z,
    double dx, double dt, double alpha_0) 
{
    int idx = blockIdx.x * blockDim.x + threadIdx.x;
    int idy = blockIdx.y * blockDim.y + threadIdx.y;
    int idz = blockIdx.z * blockDim.z + threadIdx.z;

    if (idx >= dim_x || idy >= dim_y || idz >= dim_z) return;

    int cell = idx + dim_x * (idy + dim_y * idz);

    int cell_xp = (idx + 1 < dim_x) ? cell + 1 : cell;
    int cell_xm = (idx > 0) ? cell - 1 : cell;

