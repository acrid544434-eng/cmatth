\section{Hydrodynamic Verification: Polytropic Convergence Test}
\subsection{Physical Model}
The hydrodynamic core is validated using an isolated self-gravitating polytropic sphere with index 
$n = 1.5$. The equation of state is
\begin{equation}
    P = K \rho^{1 + 1/n},
\end{equation}
where $K$ is the polytropic constant.

Simulations are executed on a $512^3$ adaptive mesh refinement (AMR) grid over 10{,}000 
cosmological timesteps using FP64 precision.

\subsection{Energy Conservation Metric}
Total energy drift is defined as
\begin{equation}
    \Delta E = \frac{E_{\text{final}} - E_0}{E_0}.
\end{equation}

\subsection{Acceptance Criterion}
\begin{equation}
    |\Delta E| < 10^{-12}.
\end{equation}

\subsection{Verification Harness}
The following FP64 validation kernel is used:
\begin{verbatim}
bool verifyPolytropicEquilibrium(double initialEnergy, double finalEnergy, 
                                 double tolerance = 1e-12) {
    double energyDrift = std::abs((finalEnergy - initialEnergy) / initialEnergy);
    std::cout << "[CLE-TEST] Polytropic Energy Drift: " << energyDrift << "\n";
    return energyDrift <= tolerance;
}
\end{verbatim}

\section{Thermodynamic Validation: Deep Space Radiative Stirling Engine}
\subsection{Thermal Configuration}
The Stirling engine operates between:
\begin{align}
    T_{\text{hot}} &= 300~\text{K}, \\
    T_{\text{cold}} &\approx 2.85~\text{K},
\end{align}
where $T_{\text{cold}}$ is computed via Stefan--Boltzmann radiative equilibrium against the 
cosmic microwave background (CMB).

\subsection{Carnot Efficiency}
\begin{equation}
    \eta_{\text{Carnot}} = 1 - \frac{T_{\text{cold}}}{T_{\text{hot}}}.
\end{equation}

Substituting values:
\begin{equation}
    \eta_{\text{Carnot}} = 1 - \frac{2.85}{300} = 0.9905.
\end{equation}

\subsection{Acceptance Criterion}
\begin{equation}
    \eta_{\text{Carnot}} > 0.99.
\end{equation}

