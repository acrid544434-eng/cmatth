\section{Formal State-Vector Definition}

\begin{equation}
S_{\text{MACSE}}(t)
=
\big(
\mathbf{X}_{\text{kin}},
\mathbf{T}_{\text{thermo}},
\mathbf{E}_{\text{astro}},
\Psi_{\text{LWE}},
\mathbf{I}_{\text{auto}}
\big)
