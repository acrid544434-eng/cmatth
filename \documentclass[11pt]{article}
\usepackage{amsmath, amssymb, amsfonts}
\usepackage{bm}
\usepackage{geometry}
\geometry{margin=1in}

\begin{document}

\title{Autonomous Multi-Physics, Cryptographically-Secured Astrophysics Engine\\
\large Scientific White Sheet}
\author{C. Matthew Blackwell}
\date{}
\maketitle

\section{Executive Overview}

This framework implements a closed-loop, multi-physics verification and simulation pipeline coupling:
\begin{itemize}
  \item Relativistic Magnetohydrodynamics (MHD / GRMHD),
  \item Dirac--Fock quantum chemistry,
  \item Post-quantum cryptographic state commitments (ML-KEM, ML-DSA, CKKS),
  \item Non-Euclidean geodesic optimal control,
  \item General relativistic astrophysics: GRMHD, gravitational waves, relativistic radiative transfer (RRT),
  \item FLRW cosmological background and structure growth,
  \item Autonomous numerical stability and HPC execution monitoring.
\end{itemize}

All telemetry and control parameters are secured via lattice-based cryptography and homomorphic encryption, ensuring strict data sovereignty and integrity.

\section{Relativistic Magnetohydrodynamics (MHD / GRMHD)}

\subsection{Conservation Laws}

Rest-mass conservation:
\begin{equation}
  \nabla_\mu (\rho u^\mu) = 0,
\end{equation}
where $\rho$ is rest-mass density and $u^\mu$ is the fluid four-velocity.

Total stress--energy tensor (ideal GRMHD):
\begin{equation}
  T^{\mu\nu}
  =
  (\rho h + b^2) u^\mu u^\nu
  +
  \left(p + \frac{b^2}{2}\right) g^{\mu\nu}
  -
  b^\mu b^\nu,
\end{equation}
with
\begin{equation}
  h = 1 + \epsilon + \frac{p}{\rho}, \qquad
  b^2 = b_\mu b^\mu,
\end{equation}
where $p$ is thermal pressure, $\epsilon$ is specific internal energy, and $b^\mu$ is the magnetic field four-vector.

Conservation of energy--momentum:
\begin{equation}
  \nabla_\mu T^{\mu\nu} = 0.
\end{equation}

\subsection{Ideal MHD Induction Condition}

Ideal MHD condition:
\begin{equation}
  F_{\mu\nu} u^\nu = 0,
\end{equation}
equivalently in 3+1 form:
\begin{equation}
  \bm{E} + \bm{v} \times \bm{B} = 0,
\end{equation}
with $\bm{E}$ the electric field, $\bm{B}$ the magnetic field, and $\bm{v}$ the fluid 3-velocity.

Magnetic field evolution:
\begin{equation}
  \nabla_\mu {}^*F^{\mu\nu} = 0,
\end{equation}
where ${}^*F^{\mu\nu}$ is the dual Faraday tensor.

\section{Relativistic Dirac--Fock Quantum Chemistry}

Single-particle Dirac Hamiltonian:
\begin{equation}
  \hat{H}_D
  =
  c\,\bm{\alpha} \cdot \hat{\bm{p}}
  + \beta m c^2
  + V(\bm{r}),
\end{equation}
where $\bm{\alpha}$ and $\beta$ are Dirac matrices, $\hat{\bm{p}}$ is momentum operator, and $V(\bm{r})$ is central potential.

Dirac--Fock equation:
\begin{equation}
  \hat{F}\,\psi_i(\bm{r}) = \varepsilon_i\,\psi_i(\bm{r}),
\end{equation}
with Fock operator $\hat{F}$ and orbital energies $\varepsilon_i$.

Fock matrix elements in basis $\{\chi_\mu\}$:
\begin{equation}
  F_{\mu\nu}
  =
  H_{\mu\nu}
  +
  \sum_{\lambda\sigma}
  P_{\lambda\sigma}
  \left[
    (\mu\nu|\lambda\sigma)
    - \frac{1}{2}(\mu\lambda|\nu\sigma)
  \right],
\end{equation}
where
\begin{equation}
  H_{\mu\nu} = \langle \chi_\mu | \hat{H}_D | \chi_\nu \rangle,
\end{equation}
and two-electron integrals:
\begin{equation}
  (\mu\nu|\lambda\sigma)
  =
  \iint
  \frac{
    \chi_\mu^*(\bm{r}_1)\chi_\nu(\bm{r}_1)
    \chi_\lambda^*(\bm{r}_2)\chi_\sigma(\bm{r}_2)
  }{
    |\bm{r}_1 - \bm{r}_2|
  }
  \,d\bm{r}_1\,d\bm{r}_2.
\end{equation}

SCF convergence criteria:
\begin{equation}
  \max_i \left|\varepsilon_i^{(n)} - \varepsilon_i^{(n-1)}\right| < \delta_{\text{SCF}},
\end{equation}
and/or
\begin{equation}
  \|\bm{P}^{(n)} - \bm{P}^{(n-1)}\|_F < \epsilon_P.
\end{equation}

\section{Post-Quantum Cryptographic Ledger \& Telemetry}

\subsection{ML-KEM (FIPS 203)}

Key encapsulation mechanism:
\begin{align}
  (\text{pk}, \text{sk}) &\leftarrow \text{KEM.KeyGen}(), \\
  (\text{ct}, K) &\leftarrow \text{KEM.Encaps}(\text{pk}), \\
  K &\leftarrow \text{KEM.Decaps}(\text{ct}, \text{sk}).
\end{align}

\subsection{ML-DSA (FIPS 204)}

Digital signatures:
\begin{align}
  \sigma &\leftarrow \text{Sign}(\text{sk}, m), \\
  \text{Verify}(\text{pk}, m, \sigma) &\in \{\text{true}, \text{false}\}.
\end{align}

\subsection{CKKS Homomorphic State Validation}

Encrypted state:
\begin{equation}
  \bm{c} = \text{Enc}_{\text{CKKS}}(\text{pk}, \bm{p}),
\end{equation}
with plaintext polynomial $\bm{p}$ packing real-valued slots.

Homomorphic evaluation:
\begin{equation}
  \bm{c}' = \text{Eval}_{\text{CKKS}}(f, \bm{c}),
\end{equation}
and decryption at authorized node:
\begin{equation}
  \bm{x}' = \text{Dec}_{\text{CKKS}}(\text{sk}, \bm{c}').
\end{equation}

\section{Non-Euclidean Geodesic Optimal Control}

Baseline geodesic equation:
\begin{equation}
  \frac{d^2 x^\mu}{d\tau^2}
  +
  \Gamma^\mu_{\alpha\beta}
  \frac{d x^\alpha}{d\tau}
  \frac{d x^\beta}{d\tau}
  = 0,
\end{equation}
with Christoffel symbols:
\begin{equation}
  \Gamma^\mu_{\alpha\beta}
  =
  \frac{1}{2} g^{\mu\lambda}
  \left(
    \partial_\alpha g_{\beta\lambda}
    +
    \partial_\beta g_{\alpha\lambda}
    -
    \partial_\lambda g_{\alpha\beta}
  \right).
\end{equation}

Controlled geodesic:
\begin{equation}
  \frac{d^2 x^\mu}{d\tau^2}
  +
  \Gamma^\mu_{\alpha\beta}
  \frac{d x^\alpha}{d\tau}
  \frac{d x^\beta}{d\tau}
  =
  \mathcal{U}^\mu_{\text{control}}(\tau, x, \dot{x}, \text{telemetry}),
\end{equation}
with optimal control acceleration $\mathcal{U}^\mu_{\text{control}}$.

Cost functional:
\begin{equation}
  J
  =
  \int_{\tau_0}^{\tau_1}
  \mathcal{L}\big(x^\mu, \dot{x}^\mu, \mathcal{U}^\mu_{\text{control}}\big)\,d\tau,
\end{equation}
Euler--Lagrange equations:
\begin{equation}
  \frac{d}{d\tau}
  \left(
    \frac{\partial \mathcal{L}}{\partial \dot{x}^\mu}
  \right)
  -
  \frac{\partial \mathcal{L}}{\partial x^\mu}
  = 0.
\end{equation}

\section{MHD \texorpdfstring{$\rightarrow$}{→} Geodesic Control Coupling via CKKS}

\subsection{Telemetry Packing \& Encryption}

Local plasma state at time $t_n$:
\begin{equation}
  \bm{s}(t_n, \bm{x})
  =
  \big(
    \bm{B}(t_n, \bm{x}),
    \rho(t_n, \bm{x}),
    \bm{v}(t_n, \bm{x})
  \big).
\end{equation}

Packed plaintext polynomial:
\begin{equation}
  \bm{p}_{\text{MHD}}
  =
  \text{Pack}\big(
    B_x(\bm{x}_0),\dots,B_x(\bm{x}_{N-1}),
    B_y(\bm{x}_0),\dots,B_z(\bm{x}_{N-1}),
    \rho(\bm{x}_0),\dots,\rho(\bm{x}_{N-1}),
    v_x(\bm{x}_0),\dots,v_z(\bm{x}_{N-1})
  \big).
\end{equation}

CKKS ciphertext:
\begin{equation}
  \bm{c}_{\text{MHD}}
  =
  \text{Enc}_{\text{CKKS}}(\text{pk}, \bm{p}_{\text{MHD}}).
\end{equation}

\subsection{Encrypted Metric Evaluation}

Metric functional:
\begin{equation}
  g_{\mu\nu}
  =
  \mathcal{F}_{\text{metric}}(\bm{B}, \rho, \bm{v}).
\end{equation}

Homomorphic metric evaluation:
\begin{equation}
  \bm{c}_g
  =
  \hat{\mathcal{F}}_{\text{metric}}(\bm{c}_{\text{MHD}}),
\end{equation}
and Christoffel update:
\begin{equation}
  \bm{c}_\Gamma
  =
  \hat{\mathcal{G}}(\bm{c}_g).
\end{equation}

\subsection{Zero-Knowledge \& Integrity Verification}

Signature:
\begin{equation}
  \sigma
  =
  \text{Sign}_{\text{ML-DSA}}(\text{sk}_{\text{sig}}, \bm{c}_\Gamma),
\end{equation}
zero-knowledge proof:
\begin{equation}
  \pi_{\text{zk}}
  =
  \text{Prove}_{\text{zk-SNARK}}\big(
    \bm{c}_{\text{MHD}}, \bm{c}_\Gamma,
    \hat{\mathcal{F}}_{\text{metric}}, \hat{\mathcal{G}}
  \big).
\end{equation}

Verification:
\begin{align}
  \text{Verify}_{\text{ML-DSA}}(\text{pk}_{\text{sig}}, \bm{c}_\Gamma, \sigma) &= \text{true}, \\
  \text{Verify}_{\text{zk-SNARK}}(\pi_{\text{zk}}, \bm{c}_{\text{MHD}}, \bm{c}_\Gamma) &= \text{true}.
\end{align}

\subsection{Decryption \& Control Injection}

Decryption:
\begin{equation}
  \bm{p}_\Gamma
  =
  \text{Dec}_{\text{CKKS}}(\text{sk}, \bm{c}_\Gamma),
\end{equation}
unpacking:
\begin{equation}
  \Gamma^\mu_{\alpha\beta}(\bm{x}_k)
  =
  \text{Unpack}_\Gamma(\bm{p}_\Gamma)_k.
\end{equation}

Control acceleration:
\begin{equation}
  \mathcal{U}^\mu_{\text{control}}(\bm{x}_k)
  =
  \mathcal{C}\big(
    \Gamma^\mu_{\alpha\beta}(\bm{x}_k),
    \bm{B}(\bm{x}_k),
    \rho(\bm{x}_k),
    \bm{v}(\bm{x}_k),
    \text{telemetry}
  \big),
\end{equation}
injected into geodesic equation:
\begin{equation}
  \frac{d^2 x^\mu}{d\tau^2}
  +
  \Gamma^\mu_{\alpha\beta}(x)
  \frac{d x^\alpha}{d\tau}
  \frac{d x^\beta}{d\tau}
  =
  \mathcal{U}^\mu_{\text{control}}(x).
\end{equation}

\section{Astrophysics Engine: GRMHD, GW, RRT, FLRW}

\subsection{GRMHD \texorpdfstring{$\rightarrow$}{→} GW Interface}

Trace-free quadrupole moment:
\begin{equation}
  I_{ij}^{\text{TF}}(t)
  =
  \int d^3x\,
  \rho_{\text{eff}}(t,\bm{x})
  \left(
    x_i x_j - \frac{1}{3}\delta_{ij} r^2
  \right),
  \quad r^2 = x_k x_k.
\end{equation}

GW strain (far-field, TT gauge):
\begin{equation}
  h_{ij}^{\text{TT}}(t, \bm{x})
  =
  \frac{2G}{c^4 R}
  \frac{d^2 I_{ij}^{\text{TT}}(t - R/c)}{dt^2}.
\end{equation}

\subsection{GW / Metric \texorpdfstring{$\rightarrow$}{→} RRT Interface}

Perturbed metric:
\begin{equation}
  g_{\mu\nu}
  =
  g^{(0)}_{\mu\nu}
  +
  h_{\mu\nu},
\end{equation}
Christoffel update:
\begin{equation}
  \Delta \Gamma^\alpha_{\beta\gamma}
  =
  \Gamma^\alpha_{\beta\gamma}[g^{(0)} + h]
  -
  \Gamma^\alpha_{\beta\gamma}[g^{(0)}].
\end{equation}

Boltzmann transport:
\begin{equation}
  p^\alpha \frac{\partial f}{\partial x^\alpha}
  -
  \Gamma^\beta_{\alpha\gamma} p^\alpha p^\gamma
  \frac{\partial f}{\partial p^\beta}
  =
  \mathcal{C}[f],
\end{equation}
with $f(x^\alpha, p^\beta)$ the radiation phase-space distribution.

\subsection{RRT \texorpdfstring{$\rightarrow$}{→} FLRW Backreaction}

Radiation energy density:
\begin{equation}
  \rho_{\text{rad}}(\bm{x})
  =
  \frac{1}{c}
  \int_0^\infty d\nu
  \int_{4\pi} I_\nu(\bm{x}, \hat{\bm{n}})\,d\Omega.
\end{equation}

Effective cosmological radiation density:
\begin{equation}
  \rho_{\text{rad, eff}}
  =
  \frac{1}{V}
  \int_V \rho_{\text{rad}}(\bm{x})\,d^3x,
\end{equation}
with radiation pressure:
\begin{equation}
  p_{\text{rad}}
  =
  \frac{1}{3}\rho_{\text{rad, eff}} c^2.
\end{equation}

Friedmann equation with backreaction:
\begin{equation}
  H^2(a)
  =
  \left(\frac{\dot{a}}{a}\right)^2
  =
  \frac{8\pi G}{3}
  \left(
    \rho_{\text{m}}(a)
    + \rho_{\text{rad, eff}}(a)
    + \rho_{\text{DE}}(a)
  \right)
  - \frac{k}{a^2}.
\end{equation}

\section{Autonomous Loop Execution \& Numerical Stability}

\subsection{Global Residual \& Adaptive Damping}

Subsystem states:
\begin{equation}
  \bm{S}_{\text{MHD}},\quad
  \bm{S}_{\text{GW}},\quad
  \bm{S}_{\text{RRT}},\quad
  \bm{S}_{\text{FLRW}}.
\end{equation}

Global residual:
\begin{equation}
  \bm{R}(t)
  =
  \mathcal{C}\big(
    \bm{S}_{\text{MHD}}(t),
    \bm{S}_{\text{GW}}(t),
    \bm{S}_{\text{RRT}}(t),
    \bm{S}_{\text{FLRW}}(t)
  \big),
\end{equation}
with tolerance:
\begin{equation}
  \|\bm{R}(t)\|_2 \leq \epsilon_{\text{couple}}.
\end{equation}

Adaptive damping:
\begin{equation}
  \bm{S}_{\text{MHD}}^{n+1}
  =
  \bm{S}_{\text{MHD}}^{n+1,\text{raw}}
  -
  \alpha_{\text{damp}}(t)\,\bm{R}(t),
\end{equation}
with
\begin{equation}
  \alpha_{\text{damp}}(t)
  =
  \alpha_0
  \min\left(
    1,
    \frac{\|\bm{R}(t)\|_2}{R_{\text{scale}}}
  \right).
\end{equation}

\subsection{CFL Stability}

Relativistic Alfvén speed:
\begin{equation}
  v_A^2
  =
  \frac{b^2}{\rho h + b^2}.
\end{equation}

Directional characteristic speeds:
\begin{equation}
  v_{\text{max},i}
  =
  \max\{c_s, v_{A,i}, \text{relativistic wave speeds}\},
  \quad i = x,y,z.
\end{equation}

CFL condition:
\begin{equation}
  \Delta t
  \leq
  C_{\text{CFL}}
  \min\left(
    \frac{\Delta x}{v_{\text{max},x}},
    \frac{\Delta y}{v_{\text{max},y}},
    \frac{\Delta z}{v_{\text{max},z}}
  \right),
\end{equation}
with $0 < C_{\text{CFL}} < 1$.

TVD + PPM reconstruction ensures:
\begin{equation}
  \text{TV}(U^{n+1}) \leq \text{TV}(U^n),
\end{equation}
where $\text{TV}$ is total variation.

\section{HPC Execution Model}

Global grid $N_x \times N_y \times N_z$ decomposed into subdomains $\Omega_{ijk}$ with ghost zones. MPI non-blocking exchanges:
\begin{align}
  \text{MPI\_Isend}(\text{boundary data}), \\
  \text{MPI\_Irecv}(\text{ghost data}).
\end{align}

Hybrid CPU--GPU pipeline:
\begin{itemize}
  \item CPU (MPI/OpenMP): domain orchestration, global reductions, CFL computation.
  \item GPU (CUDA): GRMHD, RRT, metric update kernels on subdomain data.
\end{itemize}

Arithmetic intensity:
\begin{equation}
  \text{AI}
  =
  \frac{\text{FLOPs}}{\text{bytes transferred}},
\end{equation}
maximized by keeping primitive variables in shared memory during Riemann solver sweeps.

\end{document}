\section{Relativistic Magnetohydrodynamics (MHD / GRMHD)}

\subsection{Conservation Laws}

Rest-mass conservation:
\begin{equation}
  \nabla_\mu (\rho u^\mu) = 0,
\end{equation}
where $\rho$ is rest-mass density and $u^\mu$ is the fluid four-velocity.

Total stress--energy tensor (ideal GRMHD):
\begin{equation}
  T^{\mu\nu}
  =
  (\rho h + b^2) u^\mu u^\nu
  +
  \left(p + \frac{b^2}{2}\right) g^{\mu\nu}
  -
  b^\mu b^\nu,
\end{equation}
with
\begin{equation}
  h = 1 + \epsilon + \frac{p}{\rho}, \qquad
  b^2 = b_\mu b^\mu,
\end{equation}
where $p$ is thermal pressure, $\epsilon$ is specific internal energy, and $b^\mu$ is the magnetic field four-vector.

Conservation of energy--momentum:
\begin{equation}
  \nabla_\mu T^{\mu\nu} = 0.
\end{equation}

\subsection{Ideal MHD Induction Condition}

Ideal MHD condition:
\begin{equation}
  F_{\mu\nu} u^\nu = 0,
\end{equation}
equivalently in 3+1 form:
\begin{equation}
  \bm{E} + \bm{v} \times \bm{B} = 0,
\end{equation}
with $\bm{E}$ the electric field, $\bm{B}$ the magnetic field, and $\bm{v}$ the fluid 3-velocity.

Magnetic field evolution:
\begin{equation}
  \nabla_\mu {}^*F^{\mu\nu} = 0,
\end{equation}
where ${}^*F^{\mu\nu}$ is the dual Faraday tensor.

\section{Relativistic Dirac--Fock Quantum Chemistry}

Single-particle Dirac Hamiltonian:
\begin{equation}
  \hat{H}_D
  =
  c\,\bm{\alpha} \cdot \hat{\bm{p}}
  + \beta m c^2
  + V(\bm{r}),
\end{equation}
where $\bm{\alpha}$ and $\beta$ are Dirac matrices, $\hat{\bm{p}}$ is momentum operator, and $V(\bm{r})$ is central potential.

Dirac--Fock equation:
\begin{equation}
  \hat{F}\,\psi_i(\bm{r}) = \varepsilon_i\,\psi_i(\bm{r}),
\end{equation}
with Fock operator $\hat{F}$ and orbital energies $\varepsilon_i$.

Fock matrix elements in basis $\{\chi_\mu\}$:
\begin{equation}
  F_{\mu\nu}
  =
  H_{\mu\nu}
  +
  \sum_{\lambda\sigma}
  P_{\lambda\sigma}
  \left[
    (\mu\nu|\lambda\sigma)
    - \frac{1}{2}(\mu\lambda|\nu\sigma)
  \right],
\end{equation}
where
\begin{equation}
  H_{\mu\nu} = \langle \chi_\mu | \hat{H}_D | \chi_\nu \rangle,
\end{equation}
and two-electron integrals:
\begin{equation}
  (\mu\nu|\lambda\sigma)
  =
  \iint
  \frac{
    \chi_\mu^*(\bm{r}_1)\chi_\nu(\bm{r}_1)
    \chi_\lambda^*(\bm{r}_2)\chi_\sigma(\bm{r}_2)
  }{
    |\bm{r}_1 - \bm{r}_2|
  }
  \,d\bm{r}_1\,d\bm{r}_2.
\end{equation}

SCF convergence criteria:
\begin{equation}
  \max_i \left|\varepsilon_i^{(n)} - \varepsilon_i^{(n-1)}\right| < \delta_{\text{SCF}},
\end{equation}
and/or
\begin{equation}
  \|\bm{P}^{(n)} - \bm{P}^{(n-1)}\|_F < \epsilon_P.
\end{equation}

