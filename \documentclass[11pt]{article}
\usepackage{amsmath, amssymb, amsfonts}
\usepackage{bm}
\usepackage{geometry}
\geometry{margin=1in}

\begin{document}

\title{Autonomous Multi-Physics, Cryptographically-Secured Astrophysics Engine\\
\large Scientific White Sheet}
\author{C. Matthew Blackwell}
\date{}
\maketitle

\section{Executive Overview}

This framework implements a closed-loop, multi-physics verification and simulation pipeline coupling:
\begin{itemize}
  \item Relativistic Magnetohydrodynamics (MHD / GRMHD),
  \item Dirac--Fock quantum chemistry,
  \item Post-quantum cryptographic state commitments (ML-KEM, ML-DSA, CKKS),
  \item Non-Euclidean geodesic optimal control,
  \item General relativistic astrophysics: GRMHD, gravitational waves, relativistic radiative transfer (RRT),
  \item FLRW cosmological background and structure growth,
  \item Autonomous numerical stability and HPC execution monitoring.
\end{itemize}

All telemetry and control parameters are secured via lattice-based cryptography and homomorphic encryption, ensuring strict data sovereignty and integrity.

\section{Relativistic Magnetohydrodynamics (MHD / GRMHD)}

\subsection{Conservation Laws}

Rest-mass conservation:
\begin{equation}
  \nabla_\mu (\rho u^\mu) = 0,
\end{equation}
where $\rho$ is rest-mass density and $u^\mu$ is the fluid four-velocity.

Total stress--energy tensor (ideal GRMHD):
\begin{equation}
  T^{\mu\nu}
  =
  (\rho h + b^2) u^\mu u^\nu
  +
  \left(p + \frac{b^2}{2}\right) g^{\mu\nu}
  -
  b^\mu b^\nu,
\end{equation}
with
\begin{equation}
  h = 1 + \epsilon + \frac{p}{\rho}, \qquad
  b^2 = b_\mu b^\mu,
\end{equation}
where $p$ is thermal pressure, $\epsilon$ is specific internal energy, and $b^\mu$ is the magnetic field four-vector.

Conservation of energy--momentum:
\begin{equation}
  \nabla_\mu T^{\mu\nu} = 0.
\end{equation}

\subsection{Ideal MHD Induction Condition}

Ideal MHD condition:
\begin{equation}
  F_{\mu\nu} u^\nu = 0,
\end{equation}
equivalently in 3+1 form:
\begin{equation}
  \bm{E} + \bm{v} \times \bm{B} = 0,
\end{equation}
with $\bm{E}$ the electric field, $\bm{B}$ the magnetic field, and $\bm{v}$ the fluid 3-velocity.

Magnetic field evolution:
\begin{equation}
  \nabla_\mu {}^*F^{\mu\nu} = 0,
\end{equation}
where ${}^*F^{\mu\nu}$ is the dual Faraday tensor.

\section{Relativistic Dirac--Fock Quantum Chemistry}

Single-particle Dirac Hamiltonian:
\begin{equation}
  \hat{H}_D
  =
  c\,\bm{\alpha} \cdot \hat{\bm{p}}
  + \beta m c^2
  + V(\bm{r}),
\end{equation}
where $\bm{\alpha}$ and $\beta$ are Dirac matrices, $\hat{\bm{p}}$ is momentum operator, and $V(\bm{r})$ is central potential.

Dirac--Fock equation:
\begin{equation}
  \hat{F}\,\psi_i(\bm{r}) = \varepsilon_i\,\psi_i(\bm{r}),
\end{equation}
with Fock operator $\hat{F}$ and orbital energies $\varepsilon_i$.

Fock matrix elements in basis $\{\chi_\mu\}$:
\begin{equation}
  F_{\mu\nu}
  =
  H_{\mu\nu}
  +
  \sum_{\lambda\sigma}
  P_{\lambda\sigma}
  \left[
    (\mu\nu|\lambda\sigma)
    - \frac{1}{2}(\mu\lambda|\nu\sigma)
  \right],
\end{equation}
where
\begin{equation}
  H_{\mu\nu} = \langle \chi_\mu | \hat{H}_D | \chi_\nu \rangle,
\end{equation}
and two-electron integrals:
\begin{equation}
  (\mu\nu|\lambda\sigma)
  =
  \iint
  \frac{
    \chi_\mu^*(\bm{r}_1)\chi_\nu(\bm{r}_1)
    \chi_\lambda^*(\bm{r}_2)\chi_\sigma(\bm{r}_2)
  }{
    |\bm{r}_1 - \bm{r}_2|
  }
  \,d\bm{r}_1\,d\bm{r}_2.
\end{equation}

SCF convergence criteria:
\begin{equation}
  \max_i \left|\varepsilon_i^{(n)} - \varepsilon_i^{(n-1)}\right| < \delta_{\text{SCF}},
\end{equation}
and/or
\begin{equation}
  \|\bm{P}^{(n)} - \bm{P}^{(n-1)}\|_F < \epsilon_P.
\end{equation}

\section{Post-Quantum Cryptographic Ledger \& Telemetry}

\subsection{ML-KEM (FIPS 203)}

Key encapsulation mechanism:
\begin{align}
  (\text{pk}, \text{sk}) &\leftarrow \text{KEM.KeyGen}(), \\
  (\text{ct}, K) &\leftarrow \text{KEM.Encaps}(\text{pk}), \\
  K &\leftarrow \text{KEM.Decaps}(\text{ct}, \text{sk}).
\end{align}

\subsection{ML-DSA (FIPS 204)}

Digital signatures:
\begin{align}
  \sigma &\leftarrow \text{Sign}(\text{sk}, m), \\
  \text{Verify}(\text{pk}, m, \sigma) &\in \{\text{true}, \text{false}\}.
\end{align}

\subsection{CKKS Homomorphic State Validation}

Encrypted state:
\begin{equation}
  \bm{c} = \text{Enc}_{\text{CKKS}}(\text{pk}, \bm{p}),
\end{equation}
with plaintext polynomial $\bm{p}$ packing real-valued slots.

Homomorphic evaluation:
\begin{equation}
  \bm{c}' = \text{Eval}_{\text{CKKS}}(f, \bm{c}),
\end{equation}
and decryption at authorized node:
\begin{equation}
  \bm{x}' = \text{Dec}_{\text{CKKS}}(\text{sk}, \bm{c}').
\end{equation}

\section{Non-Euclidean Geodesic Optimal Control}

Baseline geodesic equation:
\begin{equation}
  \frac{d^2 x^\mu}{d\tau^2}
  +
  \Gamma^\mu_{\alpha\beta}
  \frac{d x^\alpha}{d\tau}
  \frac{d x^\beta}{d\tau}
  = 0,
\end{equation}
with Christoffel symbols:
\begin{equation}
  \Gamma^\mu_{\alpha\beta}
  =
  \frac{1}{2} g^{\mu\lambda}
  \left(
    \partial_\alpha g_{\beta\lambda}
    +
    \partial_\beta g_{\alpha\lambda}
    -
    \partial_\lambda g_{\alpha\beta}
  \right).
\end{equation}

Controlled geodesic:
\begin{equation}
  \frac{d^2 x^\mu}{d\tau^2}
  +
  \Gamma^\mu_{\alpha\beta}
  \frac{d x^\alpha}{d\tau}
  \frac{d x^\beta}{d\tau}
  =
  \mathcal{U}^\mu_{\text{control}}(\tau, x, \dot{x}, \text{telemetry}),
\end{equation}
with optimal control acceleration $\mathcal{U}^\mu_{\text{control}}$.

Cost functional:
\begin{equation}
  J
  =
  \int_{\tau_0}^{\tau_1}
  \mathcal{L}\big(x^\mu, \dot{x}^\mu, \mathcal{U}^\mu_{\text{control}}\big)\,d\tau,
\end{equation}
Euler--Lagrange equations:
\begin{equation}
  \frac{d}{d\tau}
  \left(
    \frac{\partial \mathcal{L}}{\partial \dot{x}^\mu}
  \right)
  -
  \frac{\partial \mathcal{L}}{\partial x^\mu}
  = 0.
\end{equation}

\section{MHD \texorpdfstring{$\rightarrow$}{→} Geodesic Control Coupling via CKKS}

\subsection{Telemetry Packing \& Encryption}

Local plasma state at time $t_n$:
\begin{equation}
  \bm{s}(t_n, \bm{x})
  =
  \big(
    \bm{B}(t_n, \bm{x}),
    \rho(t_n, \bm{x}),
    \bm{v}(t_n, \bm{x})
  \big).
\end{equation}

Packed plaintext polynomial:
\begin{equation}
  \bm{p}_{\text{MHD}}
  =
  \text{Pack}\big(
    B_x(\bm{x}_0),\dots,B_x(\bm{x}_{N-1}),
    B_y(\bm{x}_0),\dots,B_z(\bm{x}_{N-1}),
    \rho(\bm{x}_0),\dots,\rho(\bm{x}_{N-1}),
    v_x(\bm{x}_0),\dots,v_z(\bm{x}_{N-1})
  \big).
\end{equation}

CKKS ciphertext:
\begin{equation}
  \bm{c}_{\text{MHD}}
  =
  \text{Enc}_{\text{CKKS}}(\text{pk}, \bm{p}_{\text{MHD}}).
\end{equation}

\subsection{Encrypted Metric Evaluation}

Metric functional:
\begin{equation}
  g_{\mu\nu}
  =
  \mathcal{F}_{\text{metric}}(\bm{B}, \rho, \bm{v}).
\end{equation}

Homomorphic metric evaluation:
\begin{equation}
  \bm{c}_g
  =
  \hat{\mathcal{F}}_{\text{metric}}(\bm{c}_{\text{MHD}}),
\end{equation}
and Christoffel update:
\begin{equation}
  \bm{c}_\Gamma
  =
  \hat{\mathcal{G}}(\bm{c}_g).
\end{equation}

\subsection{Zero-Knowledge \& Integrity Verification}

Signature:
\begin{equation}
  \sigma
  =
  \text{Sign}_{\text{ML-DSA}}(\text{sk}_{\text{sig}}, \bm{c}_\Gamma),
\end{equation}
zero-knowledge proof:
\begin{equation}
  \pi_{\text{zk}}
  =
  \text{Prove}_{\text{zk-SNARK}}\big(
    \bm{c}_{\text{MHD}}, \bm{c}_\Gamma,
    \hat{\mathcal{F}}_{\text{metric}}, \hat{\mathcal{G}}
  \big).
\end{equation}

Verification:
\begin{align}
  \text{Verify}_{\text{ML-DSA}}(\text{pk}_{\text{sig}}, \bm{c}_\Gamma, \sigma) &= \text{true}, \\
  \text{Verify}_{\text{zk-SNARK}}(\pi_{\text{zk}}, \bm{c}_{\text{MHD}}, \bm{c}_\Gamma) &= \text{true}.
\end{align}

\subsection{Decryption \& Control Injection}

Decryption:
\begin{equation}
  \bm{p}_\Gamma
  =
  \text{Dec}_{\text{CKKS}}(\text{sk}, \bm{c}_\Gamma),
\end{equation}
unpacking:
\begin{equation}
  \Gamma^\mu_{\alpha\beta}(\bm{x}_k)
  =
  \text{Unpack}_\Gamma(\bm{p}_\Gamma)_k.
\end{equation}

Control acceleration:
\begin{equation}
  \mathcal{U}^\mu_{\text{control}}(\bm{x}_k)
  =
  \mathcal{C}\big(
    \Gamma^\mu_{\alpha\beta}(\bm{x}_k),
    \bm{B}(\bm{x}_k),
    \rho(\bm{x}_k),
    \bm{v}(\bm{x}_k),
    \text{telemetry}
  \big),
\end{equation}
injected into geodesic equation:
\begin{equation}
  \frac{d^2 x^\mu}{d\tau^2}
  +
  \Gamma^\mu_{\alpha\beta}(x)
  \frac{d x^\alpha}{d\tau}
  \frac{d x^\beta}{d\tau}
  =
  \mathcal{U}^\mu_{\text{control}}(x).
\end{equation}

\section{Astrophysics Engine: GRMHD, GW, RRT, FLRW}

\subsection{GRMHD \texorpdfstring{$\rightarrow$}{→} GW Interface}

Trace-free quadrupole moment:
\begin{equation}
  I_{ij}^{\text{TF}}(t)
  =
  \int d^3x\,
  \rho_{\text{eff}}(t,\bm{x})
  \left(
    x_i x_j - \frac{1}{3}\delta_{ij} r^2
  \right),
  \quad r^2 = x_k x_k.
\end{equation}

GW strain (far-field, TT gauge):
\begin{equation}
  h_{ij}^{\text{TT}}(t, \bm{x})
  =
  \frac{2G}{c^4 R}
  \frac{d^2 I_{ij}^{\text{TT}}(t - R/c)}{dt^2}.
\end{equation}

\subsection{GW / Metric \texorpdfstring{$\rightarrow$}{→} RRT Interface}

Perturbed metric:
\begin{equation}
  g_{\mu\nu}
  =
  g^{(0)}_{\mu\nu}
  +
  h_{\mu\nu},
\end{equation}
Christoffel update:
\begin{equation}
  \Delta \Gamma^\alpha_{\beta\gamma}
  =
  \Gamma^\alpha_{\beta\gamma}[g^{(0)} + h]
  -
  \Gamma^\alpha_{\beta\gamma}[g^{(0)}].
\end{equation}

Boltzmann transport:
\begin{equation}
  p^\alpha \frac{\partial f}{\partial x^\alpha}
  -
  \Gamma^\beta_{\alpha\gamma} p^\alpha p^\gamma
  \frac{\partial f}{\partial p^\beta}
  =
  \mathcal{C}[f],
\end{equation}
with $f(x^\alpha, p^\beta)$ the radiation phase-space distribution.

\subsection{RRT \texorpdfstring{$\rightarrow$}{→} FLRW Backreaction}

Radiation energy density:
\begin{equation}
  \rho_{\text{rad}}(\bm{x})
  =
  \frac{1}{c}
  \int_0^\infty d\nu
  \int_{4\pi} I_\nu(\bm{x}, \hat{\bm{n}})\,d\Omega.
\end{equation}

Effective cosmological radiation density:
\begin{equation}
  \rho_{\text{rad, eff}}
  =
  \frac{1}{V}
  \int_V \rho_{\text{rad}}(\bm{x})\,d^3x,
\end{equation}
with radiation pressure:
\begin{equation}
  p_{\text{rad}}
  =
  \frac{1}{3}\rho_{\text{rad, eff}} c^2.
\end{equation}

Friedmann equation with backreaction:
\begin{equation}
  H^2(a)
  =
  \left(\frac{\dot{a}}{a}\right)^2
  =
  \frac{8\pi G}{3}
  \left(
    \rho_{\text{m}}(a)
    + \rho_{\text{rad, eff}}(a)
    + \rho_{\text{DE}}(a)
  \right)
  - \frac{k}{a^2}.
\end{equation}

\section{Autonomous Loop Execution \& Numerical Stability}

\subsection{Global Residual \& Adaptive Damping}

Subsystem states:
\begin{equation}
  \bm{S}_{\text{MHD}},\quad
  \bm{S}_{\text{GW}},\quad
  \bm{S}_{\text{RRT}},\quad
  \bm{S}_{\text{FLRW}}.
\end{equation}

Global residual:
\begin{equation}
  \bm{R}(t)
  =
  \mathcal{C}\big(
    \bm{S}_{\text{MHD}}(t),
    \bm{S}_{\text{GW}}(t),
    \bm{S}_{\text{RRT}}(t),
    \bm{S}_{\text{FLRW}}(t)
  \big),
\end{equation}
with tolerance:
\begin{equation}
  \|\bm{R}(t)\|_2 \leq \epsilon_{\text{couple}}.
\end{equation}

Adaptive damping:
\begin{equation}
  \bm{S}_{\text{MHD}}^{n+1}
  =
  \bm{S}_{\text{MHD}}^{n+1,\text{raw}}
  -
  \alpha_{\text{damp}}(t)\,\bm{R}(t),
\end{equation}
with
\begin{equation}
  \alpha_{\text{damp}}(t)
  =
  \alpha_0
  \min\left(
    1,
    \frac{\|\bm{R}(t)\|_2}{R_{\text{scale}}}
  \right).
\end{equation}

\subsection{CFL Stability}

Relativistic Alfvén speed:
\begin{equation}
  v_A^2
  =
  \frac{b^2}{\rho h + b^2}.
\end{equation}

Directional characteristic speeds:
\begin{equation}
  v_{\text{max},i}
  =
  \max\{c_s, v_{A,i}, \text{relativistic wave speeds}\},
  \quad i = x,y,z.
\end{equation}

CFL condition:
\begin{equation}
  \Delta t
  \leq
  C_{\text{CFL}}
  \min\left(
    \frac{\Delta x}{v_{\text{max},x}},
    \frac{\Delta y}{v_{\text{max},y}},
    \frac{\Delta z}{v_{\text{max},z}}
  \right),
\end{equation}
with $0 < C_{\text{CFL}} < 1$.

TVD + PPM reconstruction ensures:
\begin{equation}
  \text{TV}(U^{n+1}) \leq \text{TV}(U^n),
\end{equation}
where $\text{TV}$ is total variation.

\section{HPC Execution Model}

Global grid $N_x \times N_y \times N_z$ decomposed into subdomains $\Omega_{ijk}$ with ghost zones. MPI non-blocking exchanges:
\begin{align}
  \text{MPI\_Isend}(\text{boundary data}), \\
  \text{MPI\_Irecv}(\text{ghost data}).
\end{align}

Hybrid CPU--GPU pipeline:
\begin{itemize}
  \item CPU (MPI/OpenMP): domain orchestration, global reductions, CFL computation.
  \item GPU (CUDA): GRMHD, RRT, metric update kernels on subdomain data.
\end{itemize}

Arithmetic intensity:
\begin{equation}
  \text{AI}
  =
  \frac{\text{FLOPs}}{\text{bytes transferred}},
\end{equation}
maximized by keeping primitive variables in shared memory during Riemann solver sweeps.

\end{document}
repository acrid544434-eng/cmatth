  \mathcal{C}\big(
    \bm{S}_{\text{MHD}}(t),
    \bm{S}_{\text{GW}}(t),
    \bm{S}_{\text{RRT}}(t),
    \bm{S}_{\text{FLRW}}(t)
  \big),
\end{equation}
with tolerance:
\begin{equation}
  \|\bm{R}(t)\|_2 \leq \epsilon_{\text{couple}}.
