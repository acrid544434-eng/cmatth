  \frac{2G}{c^4 R}
  \frac{d^2 I_{ij}^{\text{TT}}(t - R/c)}{dt^2}.
\end{equation}

\subsection{GW / Metric \texorpdfstring{$\rightarrow$}{→} RRT Interface}

Perturbed metric:
\begin{equation}
  g_{\mu\nu}
  =
  g^{(0)}_{\mu\nu}
  +
  h_{\mu\nu},
\end{equation}
Christoffel update:
\begin{equation}
  \Delta \Gamma^\alpha_{\beta\gamma}
  =
  \Gamma^\alpha_{\beta\gamma}[g^{(0)} + h]
  -
  \Gamma^\alpha_{\beta\gamma}[g^{(0)}].
\end{equation}

Boltzmann transport:
\begin{equation}
  p^\alpha \frac{\partial f}{\partial x^\alpha}
  -
  \Gamma^\beta_{\alpha\gamma} p^\alpha p^\gamma
  \frac{\partial f}{\partial p^\beta}
  =
  \mathcal{C}[f],
\end{equation}
with $f(x^\alpha, p^\beta)$ the radiation phase-space distribution.

