\section*{3. Fault Tree Analysis (FTA)}
\textbf{Top-Level Hazard (H1):} Catastrophic loss of cryptographic sovereignty or unrecoverable telemetry corruption.

\[
\text{H1} \iff (\text{PQC Verification Failure}) \lor (\text{Unencrypted Leakage}) \lor (\text{DTN Routing Collapse})
\]

\subsection*{3.1 Sub-Fault Tree: Unencrypted Data Leakage}
\[
\text{Leakage} \iff (D_{\text{raw}} \text{ present outside enclave}) \land (\text{Sovereignty Invariant Violated})
\]

\[
\forall R: \neg\exists D_{\text{raw}} \in R
\]

\subsection*{3.2 Sub-Fault Tree: DTN Custody Failure}
\[
\text{DTN Failure} \iff (\text{Ephemeris Desync}) \lor (\tau_{\text{exp}} \text{ exceeded})
\]

\[
\tau_{\text{exp}} = t_{\text{creation}} + \Delta t_{\text{valid}}
\]

\section*{4. Fault Containment Regions}
\begin{itemize}
    \item \textbf{FCR-1: Sensor Ingestion Boundary} — SEU-induced corruption cannot propagate past AXI4 enclave.
    \item \textbf{FCR-2: Crypto Enclave Boundary} — All plaintext confined to secure hardware regions.
    \item \textbf{FCR-3: DTN Routing Boundary} — Custody failures isolated from NVM persistence.
\end{itemize}

\section*{5. Safe Mode Entry Conditions}
\[
\text{SafeMode} \iff (\tau_{\text{enc}} > 5\text{ ms}) \lor (\text{verify}_{\text{ECOSA}} = \text{false})
\]

\section*{6. Risk Mitigation Architecture}
\begin{itemize}
    \item Continuous FPGA scrubbing for SEU mitigation.
    \item Autonomous watchdog fallback to hardened micro-code states.
    \item Zero-plaintext guarantee enforced by hardware sovereignty invariants.
\end{itemize}

