\section*{4. Mathematical Definitions}
\subsection*{4.1 Signal-to-Noise Ratio (SNR)}
\[
\text{SNR} = \frac{\mu_{\text{signal}}}{\sigma_{\text{noise}}}
\]
\textbf{Pass Criterion:} \(\text{SNR} \ge 10\).

\subsection*{4.2 False Alarm Rate (FAR)}
\[
\text{FAR} = \frac{N_{\text{false}}}{T_{\text{obs}}}
\]
\textbf{Pass Criterion:} \(\text{FAR} \le \frac{1}{1000\ \text{yr}}\).

\section*{5. Test Case Procedures}

\subsection*{5.1 TC-A1: Multi-Spectral Transient Validation}
\begin{itemize}
    \item Extract raw frames \(D_{\text{raw}}(t,\lambda,\Omega)\) around timestamp \(t_0\).
    \item Apply calibration pipeline:
    \[
    \mathcal{C}_{\text{cal}} = \mathcal{C}_{\text{bias}} \circ \mathcal{C}_{\text{dark}} \circ \mathcal{C}_{\text{flat}}.
    \]
    \item Compute flux curve \(F(t)\) and spectrum \(S(\lambda)\).
    \item Cross-match coordinates with TNS, Gaia, Pan-STARRS.
    \item \textbf{Pass:} SNR $\ge 10$, $p_{\text{noise}} \le 10^{-5}$, no prior catalog match.
\end{itemize}

\subsection*{5.2 TC-B1: Exoplanet Transit Validation}
\begin{itemize}
    \item Identify periodic flux dips:
    \[
    F(t) = F_0 - \Delta F \cdot \Pi(t; P, \tau).
    \]
    \item Fit Mandel-Agol transit model.
    \item Verify multi-band consistency:
    \[
    \Delta F_b \approx \Delta F_{\text{model},b}.
    \]
    \item \textbf{Pass:} Consistent depth across bands; convergent \(R_p/R_\star\).
\end{itemize}

\subsection*{5.3 TC-C1: Gravitational-Wave Validation}
\begin{itemize}
    \item Perform matched filtering:
    \[
    \rho_k = \frac{\langle h, h_k \rangle}{\sqrt{\langle h_k, h_k \rangle}}.
    \]
    \item Compute FAR using off-source background.
    \item Cross-check with LIGO/Virgo/KAGRA alerts.
    \item \textbf{Pass:} \(\rho_{\max} \ge 8\), FAR $\le 1/1000$ yr.
\end{itemize}

\subsection*{5.4 TC-D1: Cryptographic Sovereignty}
\begin{itemize}
    \item Extract RFC 9171 bundles:
    \[
    \mathcal{B}_k = (\text{header}, P_k^{\text{enc}}, S_{\text{auth}}, \tau_{\text{exp}}).
    \]
    \item Verify PQC ECOSA signatures:
    \[
    \text{verify}_{\text{ECOSA}}(P_k^{\text{enc}}, S_{\text{auth}}) = \text{true}.
    \]
    \item Validate homomorphic correctness using encrypted test vectors.
    \item \textbf{Pass:} \(\tau_{\text{enc}} \le 5\text{ ms}\), zero signature failures.
\end{itemize}

\subsection*{5.5 TC-D2: Plaintext Exposure Audit}
