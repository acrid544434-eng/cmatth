= -\sum_i p_i \log p_i \; \mathcal{R}.
\end{equation}

\section{Variational Derivation}
Starting from the action
\begin{equation}
S = \int d^4x \sqrt{-g}
\left( \frac{c^4}{16\pi G} R + \mathcal{L}_{\text{matter}}
+ \mathcal{C}_{\text{entropy}} \right),
