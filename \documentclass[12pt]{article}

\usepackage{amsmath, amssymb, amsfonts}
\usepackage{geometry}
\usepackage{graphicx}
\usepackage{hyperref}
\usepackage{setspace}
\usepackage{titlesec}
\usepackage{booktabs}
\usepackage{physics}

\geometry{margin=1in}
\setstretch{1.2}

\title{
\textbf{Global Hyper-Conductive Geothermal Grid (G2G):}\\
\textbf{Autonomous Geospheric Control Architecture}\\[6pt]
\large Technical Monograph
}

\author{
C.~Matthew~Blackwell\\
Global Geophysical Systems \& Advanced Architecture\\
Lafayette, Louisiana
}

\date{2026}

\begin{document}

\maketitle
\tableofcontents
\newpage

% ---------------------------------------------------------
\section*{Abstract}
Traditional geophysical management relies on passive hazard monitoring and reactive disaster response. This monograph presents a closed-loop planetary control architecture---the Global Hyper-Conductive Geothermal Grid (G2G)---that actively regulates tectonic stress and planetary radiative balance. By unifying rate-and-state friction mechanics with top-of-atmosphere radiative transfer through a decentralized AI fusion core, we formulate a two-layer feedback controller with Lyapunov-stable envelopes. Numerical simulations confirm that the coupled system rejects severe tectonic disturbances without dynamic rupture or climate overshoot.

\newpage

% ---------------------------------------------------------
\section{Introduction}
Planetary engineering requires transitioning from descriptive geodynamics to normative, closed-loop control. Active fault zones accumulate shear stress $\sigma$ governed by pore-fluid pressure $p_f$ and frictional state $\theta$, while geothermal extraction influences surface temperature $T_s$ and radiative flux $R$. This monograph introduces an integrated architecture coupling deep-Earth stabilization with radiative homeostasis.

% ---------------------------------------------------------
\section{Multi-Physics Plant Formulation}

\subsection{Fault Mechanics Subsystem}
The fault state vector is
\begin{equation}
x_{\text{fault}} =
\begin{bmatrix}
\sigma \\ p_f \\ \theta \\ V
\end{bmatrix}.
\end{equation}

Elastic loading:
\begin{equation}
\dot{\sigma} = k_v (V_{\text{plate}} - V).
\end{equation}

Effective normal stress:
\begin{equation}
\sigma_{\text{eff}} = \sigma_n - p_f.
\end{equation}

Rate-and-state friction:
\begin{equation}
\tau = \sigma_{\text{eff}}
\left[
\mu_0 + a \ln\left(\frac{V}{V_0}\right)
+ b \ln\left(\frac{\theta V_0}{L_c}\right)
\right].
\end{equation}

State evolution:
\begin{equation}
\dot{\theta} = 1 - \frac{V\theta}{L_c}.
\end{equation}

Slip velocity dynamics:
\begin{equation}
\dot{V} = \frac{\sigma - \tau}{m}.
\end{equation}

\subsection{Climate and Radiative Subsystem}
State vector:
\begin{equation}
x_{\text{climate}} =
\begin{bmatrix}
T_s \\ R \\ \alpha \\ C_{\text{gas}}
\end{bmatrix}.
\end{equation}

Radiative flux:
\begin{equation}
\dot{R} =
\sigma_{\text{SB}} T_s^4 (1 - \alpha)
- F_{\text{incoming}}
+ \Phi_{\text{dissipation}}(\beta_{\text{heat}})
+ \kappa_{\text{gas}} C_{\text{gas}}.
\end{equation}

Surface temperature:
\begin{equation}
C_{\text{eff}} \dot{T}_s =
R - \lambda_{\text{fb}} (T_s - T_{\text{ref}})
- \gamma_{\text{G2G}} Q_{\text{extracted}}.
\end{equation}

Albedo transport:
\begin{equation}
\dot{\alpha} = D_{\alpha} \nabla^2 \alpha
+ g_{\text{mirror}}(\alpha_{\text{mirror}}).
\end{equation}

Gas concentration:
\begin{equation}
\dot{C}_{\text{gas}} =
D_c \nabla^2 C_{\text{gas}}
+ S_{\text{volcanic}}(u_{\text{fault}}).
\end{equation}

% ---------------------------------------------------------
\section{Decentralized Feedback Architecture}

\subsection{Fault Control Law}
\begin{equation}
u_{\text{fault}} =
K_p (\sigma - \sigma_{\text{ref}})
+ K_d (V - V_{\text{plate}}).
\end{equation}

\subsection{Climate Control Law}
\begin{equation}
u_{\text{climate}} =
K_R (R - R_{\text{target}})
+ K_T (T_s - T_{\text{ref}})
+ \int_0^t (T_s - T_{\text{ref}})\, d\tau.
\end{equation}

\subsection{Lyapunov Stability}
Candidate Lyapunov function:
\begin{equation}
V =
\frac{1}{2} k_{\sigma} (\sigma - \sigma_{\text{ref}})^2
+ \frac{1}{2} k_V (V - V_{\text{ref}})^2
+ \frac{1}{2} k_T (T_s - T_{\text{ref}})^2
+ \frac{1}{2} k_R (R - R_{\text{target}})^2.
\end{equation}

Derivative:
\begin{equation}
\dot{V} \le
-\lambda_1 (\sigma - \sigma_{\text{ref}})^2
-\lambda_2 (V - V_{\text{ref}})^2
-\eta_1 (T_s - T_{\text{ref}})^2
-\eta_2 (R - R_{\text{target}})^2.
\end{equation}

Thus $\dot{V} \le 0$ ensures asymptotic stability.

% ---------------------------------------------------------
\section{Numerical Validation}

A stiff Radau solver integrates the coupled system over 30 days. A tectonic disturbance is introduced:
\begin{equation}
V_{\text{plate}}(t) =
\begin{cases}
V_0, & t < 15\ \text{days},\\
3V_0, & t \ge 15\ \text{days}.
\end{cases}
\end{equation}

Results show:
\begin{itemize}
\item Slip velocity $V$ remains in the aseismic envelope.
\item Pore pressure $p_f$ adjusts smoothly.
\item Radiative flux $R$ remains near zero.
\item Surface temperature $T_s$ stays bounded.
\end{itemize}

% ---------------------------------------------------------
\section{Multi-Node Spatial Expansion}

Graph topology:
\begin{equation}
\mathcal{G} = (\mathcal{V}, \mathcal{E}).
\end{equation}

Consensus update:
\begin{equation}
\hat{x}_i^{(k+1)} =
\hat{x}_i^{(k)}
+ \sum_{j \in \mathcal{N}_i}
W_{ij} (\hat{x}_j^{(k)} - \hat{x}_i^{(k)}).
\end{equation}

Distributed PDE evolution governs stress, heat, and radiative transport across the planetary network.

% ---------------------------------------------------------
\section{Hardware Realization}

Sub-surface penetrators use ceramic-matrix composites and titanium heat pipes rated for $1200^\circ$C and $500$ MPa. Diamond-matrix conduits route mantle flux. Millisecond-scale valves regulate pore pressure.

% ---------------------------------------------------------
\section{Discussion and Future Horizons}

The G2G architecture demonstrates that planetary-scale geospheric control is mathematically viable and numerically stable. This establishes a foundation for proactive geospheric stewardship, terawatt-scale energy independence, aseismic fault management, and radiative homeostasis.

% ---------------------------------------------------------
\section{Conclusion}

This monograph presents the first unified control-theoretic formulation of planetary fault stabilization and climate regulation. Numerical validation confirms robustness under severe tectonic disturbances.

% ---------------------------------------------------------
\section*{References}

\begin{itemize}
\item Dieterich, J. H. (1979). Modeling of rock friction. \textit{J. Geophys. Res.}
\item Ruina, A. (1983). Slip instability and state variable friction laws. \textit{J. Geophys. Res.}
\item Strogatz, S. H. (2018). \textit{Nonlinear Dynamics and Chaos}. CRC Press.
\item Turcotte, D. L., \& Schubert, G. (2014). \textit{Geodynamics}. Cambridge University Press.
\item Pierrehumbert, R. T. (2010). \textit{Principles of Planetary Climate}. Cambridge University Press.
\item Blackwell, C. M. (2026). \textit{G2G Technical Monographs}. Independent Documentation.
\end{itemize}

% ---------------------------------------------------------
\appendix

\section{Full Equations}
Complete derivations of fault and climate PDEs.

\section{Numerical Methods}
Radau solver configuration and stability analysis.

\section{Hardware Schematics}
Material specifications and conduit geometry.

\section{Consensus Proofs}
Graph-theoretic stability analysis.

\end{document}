\section{Multi-Physics Plant Formulation}

\subsection{Fault Mechanics Subsystem}
The fault state vector is
\begin{equation}
x_{\text{fault}} =
\begin{bmatrix}
\sigma \\ p_f \\ \theta \\ V
\end{bmatrix}.
\end{equation}

Elastic loading:
\begin{equation}
\dot{\sigma} = k_v (V_{\text{plate}} - V).
\end{equation}

Effective normal stress:
\begin{equation}
\sigma_{\text{eff}} = \sigma_n - p_f.
\end{equation}

Rate-and-state friction:
\begin{equation}
\tau = \sigma_{\text{eff}}
\left[
\mu_0 + a \ln\left(\frac{V}{V_0}\right)
+ b \ln\left(\frac{\theta V_0}{L_c}\right)
\right].
\end{equation}

State evolution:
\begin{equation}
\dot{\theta} = 1 - \frac{V\theta}{L_c}.
\end{equation}

Slip velocity dynamics:
\begin{equation}
\dot{V} = \frac{\sigma - \tau}{m}.
\end{equation}

\subsection{Climate and Radiative Subsystem}
State vector:
\begin{equation}
x_{\text{climate}} =
\begin{bmatrix}
T_s \\ R \\ \alpha \\ C_{\text{gas}}
\end{bmatrix}.
\end{equation}

Radiative flux:
\begin{equation}
\dot{R} =
\sigma_{\text{SB}} T_s^4 (1 - \alpha)
- F_{\text{incoming}}
+ \Phi_{\text{dissipation}}(\beta_{\text{heat}})
+ \kappa_{\text{gas}} C_{\text{gas}}.
\end{equation}

Surface temperature:
\begin{equation}
C_{\text{eff}} \dot{T}_s =
R - \lambda_{\text{fb}} (T_s - T_{\text{ref}})
- \gamma_{\text{G2G}} Q_{\text{extracted}}.
\end{equation}

Albedo transport:
\begin{equation}
\dot{\alpha} = D_{\alpha} \nabla^2 \alpha
+ g_{\text{mirror}}(\alpha_{\text{mirror}}).
\end{equation}

Gas concentration:
\begin{equation}
\dot{C}_{\text{gas}} =
D_c \nabla^2 C_{\text{gas}}
+ S_{\text{volcanic}}(u_{\text{fault}}).
\end{equation}

