\section{Decentralized Feedback Architecture}

\subsection{Fault Control Law}
\begin{equation}
u_{\text{fault}} =
K_p (\sigma - \sigma_{\text{ref}})
+ K_d (V - V_{\text{plate}}).
\end{equation}

\subsection{Climate Control Law}
\begin{equation}
u_{\text{climate}} =
K_R (R - R_{\text{target}})
+ K_T (T_s - T_{\text{ref}})
+ \int_0^t (T_s - T_{\text{ref}})\, d\tau.
\end{equation}

\subsection{Lyapunov Stability}
Candidate Lyapunov function:
\begin{equation}
V =
\frac{1}{2} k_{\sigma} (\sigma - \sigma_{\text{ref}})^2
+ \frac{1}{2} k_V (V - V_{\text{ref}})^2
+ \frac{1}{2} k_T (T_s - T_{\text{ref}})^2
+ \frac{1}{2} k_R (R - R_{\text{target}})^2.
\end{equation}

Derivative:
\begin{equation}
\dot{V} \le
-\lambda_1 (\sigma - \sigma_{\text{ref}})^2
-\lambda_2 (V - V_{\text{ref}})^2
-\eta_1 (T_s - T_{\text{ref}})^2
-\eta_2 (R - R_{\text{target}})^2.
\end{equation}

Thus $\dot{V} \le 0$ ensures asymptotic stability.

