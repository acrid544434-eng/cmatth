\section{Scientific Foundations}

\subsection{Shallow-Water Dynamics}
Let $h(x,t)$ denote water depth and $u(x,t)$ horizontal velocity. The shallow-water equations are:
\[
\frac{\partial h}{\partial t} + \nabla \cdot (h u) = 0,
\]
\[
\frac{\partial (h u)}{\partial t} + \nabla \cdot \left( h u \otimes u + \frac{1}{2} g h^2 I \right)
= -g h \nabla z + S,
\]
where $z$ is bed elevation and $S$ represents pump/weir actuation.

\subsection{Closed-Loop Stability}
Define state vector $x(t)$ and control input $u(t)$. A Lyapunov function $V(x)$ must satisfy:
\[
V(x) > 0, \qquad \frac{dV}{dt} \leq 0,
\]
ensuring asymptotic stability under storm forcing.

\subsection{Overshoot Bounds}
Actuation latency $\tau_{\max}$ must satisfy:
\[
h(t) \leq h_{\text{safe}},
\]
preventing catastrophic overtopping.

\subsection{Safety Invariants}
Under telemetry failure:
\begin{itemize}
    \item spillways default to gravity-bleed,
    \item pumps enter low-power routing,
    \item weirs lock into safe positions.
\end{itemize}

