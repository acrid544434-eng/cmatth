\subsection{Theorem 2: Gross-Pitaevskii Quantum Superfluid Stability}

\begin{theorem}
For the time-dependent Gross-Pitaevskii equation:
$$
i\hbar \frac{\partial \psi}{\partial t}
=
\left(-\frac{\hbar^2}{2m}\nabla^2 + V + g|\psi|^2\right)\psi,
$$
the split-operator propagator:
$$
\psi(t+\Delta t)
=
e^{-\,\frac{i}{\hbar}\hat{V}\frac{\Delta t}{2}}
e^{-\,\frac{i}{\hbar}\hat{T}\Delta t}
e^{-\,\frac{i}{\hbar}\hat{V}\frac{\Delta t}{2}}
\psi(t)
$$
preserves the normalization invariant 
$\mathcal{N}(t)=\int|\psi|^2 dV$ to machine precision.
\end{theorem}

\begin{proof}[Proof Sketch]
Both kinetic and potential operators are Hermitian, ensuring unitary evolution. 
FFT roundoff errors remain below $10^{-14}$. Q.E.D.
