\hat{\Lambda}^{(n)} =
\text{multi-loop corrections, vacuum polarization, nonlinear feedback}.
\]

\chapter{Numerical Evolution}
The evolution operator is:
\[
\hat{\mathcal{U}}(t) =
\exp\left( -\frac{i}{\hbar} \hat{\mathcal{H}}_{\text{total}} t \right).
\]

