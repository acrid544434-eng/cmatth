\chapter{Magnetohydrodynamic Plasma Theory}

\section{Ideal MHD Equations}
Mass conservation:
\begin{equation}
\partial_t \rho + \nabla\cdot(\rho\mathbf{v}) = 0.
\end{equation}

Momentum conservation:
\begin{equation}
\partial_t (\rho\mathbf{v}) + 
\nabla\cdot\left[
\rho\mathbf{v}\mathbf{v} + 
\left(p + \frac{B^2}{2\mu_0}\right)\mathbf{I} - 
\frac{\mathbf{B}\mathbf{B}}{\mu_0}
\right] = 0.
\end{equation}

Induction equation:
\begin{equation}
\partial_t \mathbf{B} = 
\nabla\times(\mathbf{v}\times\mathbf{B}).
\end{equation}

