\chapter{Mathematical Preliminaries}

\section{Tensor Calculus}
A tensor of rank $(m,n)$ is defined as a multilinear map
\[
T : \underbrace{V^* \times \cdots \times V^*}_{m}
\times
\underbrace{V \times \cdots \times V}_{n}
\rightarrow \mathbb{R}.
\]
SIM-COSMIC-CODE employs mixed-rank tensors for curvature sampling,
metric evolution, and stress-energy propagation.

\subsection{Index Manipulation}
Raising and lowering indices uses the metric:
\[
V^\mu = g^{\mu\nu} V_\nu, \qquad
V_\mu = g_{\mu\nu} V^\nu.
\]

\subsection{Covariant Derivatives}
The covariant derivative of a vector field is
\[
\nabla_\mu V^\nu = \partial_\mu V^\nu + \Gamma^\nu_{\mu\lambda} V^\lambda.
\]

\section{Differential Geometry}
Let $(\mathcal{M}, g_{\mu\nu})$ be a smooth Lorentzian manifold. The Levi-Civita
connection satisfies
\[
\nabla_\lambda g_{\mu\nu} = 0.
\]

\subsection{Christoffel Symbols}
\[
\Gamma^\rho_{\mu\nu}
= \frac{1}{2} g^{\rho\sigma}
\left(
\partial_\mu g_{\sigma\nu}
+ \partial_\nu g_{\sigma\mu}
- \partial_\sigma g_{\mu\nu}
\right).
\]

\section{Manifold Structures}
The simulation discretizes $\mathcal{M}$ into Planck-scale cells. Each cell
stores:
\begin{itemize}
    \item local metric $g_{\mu\nu}$,
    \item curvature scalars $(R, R_{\mu\nu}R^{\mu\nu})$,
    \item constraint fields $(H, M_i)$,
    \item vacuum energy density samples.
\end{itemize}

\section{Curvature Operators}
The Riemann tensor is computed as
\[
R^\rho_{\ \sigma\mu\nu}
= \partial_\mu \Gamma^\rho_{\nu\sigma}
- \partial_\nu \Gamma^\rho_{\mu\sigma}
+ \Gamma^\rho_{\mu\lambda}\Gamma^\lambda_{\nu\sigma}
- \Gamma^\rho_{\nu\lambda}\Gamma^\lambda_{\mu\sigma}.
\]

\subsection{Ricci Tensor}
\[
R_{\mu\nu} = R^\lambda_{\ \mu\lambda\nu}.
\]

\subsection{Scalar Curvature}
\[
R = g^{\mu\nu} R_{\mu\nu}.
\]

