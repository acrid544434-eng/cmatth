\chapter{Classical Field Theory}

\section{Action Principles}
The Einstein-Hilbert action is
\[
S = \frac{c^3}{16\pi G} \int R \sqrt{-g}\, d^4x.
\]

\section{Euler-Lagrange Equations}
Variation with respect to $g_{\mu\nu}$ yields the Einstein field equations.

\section{Stress-Energy Tensor}
Defined by
\[
T_{\mu\nu} = -\frac{2}{\sqrt{-g}}
\frac{\delta (\mathcal{L}_m \sqrt{-g})}{\delta g^{\mu\nu}}.
\]

\section{Conservation Laws}
The Bianchi identity enforces
\[
\nabla_\mu G^{\mu\nu} = 0.
\]

