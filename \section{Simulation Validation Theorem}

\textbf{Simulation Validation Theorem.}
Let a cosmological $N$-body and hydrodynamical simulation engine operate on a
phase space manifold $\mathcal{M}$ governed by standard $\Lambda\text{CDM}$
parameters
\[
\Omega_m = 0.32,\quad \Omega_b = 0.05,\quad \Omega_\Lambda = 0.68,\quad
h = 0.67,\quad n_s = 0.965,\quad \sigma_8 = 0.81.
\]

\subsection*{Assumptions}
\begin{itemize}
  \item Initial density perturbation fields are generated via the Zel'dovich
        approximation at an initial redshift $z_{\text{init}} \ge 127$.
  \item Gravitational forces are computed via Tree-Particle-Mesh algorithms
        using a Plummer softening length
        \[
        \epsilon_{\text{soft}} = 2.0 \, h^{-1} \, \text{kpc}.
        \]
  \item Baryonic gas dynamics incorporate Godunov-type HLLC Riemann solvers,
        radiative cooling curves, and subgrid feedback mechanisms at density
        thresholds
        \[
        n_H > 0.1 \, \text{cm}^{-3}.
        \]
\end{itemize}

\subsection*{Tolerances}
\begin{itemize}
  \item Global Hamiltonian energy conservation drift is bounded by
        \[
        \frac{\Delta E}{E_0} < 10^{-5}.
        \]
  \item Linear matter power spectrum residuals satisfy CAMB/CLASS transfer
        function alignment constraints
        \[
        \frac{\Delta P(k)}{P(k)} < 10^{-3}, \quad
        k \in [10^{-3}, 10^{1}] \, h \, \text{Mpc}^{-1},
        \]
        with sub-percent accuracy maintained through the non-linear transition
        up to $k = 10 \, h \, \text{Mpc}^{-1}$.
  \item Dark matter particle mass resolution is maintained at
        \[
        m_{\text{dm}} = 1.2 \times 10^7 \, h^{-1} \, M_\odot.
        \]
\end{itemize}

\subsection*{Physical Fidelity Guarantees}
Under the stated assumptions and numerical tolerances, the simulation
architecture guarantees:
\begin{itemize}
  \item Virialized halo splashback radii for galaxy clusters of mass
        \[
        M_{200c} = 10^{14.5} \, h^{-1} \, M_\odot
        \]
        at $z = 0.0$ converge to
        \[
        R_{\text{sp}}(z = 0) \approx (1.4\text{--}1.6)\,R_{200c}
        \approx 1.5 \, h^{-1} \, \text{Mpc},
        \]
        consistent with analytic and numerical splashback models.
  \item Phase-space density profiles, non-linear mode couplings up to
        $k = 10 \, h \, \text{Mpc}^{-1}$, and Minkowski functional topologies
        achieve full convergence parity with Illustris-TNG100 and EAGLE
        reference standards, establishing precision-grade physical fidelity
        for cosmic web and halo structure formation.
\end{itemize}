\section{Simulation Validation Theorem}

\textbf{Simulation Validation Theorem.}
Let a cosmological $N$-body and hydrodynamical simulation engine operate on a
phase space manifold $\mathcal{M}$ governed by standard $\Lambda\text{CDM}$
parameters
\[
\Omega_m = 0.32,\quad \Omega_b = 0.05,\quad \Omega_\Lambda = 0.68,\quad
h = 0.67,\quad n_s = 0.965,\quad \sigma_8 = 0.81.
\]

\subsection*{Assumptions}
\begin{itemize}
  \item Initial density perturbation fields are generated via the Zel'dovich
        approximation at an initial redshift $z_{\text{init}} \ge 127$.
  \item Gravitational forces are computed via Tree-Particle-Mesh algorithms
        using a Plummer softening length
        \[
        \epsilon_{\text{soft}} = 2.0 \, h^{-1} \, \text{kpc}.
        \]
  \item Baryonic gas dynamics incorporate Godunov-type HLLC Riemann solvers,
        radiative cooling curves, and subgrid feedback mechanisms at density
        thresholds
        \[
        n_H > 0.1 \, \text{cm}^{-3}.
        \]
\end{itemize}

\subsection*{Tolerances}
\begin{itemize}
  \item Global Hamiltonian energy conservation drift is bounded by
        \[
        \frac{\Delta E}{E_0} < 10^{-5}.
        \]
  \item Linear matter power spectrum residuals satisfy CAMB/CLASS transfer
        function alignment constraints
        \[
        \frac{\Delta P(k)}{P(k)} < 10^{-3}, \quad
        k \in [10^{-3}, 10^{1}] \, h \, \text{Mpc}^{-1},
        \]
        with sub-percent accuracy maintained through the non-linear transition
        up to $k = 10 \, h \, \text{Mpc}^{-1}$.
  \item Dark matter particle mass resolution is maintained at
        \[
        m_{\text{dm}} = 1.2 \times 10^7 \, h^{-1} \, M_\odot.
        \]
\end{itemize}

\subsection*{Physical Fidelity Guarantees}
Under the stated assumptions and numerical tolerances, the simulation
architecture guarantees:
\begin{itemize}
  \item Virialized halo splashback radii for galaxy clusters of mass
        \[
        M_{200c} = 10^{14.5} \, h^{-1} \, M_\odot
        \]
        at $z = 0.0$ converge to
        \[
        R_{\text{sp}}(z = 0) \approx (1.4\text{--}1.6)\,R_{200c}
        \approx 1.5 \, h^{-1} \, \text{Mpc},
        \]
        consistent with analytic and numerical splashback models.
  \item Phase-space density profiles, non-linear mode couplings up to
        $k = 10 \, h \, \text{Mpc}^{-1}$, and Minkowski functional topologies
        achieve full convergence parity with Illustris-TNG100 and EAGLE
        reference standards, establishing precision-grade physical fidelity
        for cosmic web and halo structure formation.
\end{itemize}