def run_generation(self, steps_per_individual):
        # 1. Run each universe and evaluate fitness
        for indiv in self.population:
            engine = indiv["engine"]
            for _ in range(steps_per_individual):
                engine.step()
            indiv["fitness"] = self.fitness_fn(engine)

        # 2. Sort by fitness (descending)
        self.population.sort(key=lambda x: x["fitness"], reverse=True)

        # 3. Elitism: keep top N
        elite_count = max(1, int(self.elite_fraction * self.population_size))
        elites = self.population[:elite_count]

        # 4. Build new population: keep elites, fill rest with offspring
        new_population = [self._clone_individual(e) for e in elites]

        # 5. Selection probabilities
        fitnesses = [indiv["fitness"] for indiv in self.population]
        total_f = sum(fitnesses) + 1e-12
        probs = [f / total_f for f in fitnesses]

        # 6. Generate offspring
        while len(new_population) < self.population_size:
            parent = random.choices(self.population, weights=probs, k=1)[0]
            child_genome = mutate_genome(parent["genome"])
            child = self._create_individual(child_genome)
            new_population.append(child)

        self.population = new_population
        self.generation += 1